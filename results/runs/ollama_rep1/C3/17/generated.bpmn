<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="System" processRef="SystemProcess"/>
    <bpmn:participant id="p3" name="Inventory System" processRef="InventorySystemProcess"/>
    <bpmn:participant id="p4" name="Warehouse" processRef="WarehouseProcess"/>
    <bpmn:participant id="p5" name="Quality Control" processRef="QualityControlProcess"/>
    <bpmn:participant id="p6" name="Packaging" processRef="PackagingProcess"/>
    <bpmn:participant id="p7" name="Shipping Department" processRef="ShippingDepartmentProcess"/>
    <bpmn:participant id="p8" name="Returns Department" processRef="ReturnsDepartmentProcess"/>
    <bpmn:messageFlow id="mf1" name="Place Order" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Payment Confirmation" sourceRef="t3" targetRef="ice1"/>
    <bpmn:messageFlow id="mf3" name="Payment Failed" sourceRef="t4" targetRef="ice2"/>
    <bpmn:messageFlow id="mf4" name="Stock Availability" sourceRef="t5" targetRef="se6"/>
    <bpmn:messageFlow id="mf5" name="Out of Stock" sourceRef="t6" targetRef="ice3"/>
    <bpmn:messageFlow id="mf6" name="Back Order" sourceRef="t7" targetRef="ice4"/>
    <bpmn:messageFlow id="mf7" name="Items Available" sourceRef="t8" targetRef="se9"/>
    <bpmn:messageFlow id="mf8" name="Picked Items" sourceRef="t9" targetRef="se10"/>
    <bpmn:messageFlow id="mf9" name="Quality Checked" sourceRef="t10" targetRef="se11"/>
    <bpmn:messageFlow id="mf10" name="Packaged" sourceRef="t11" targetRef="se12"/>
    <bpmn:messageFlow id="mf11" name="Gift Wrapped" sourceRef="t12" targetRef="se13"/>
    <bpmn:messageFlow id="mf12" name="Shipping Documents" sourceRef="t13" targetRef="se14"/>
    <bpmn:messageFlow id="mf13" name="Customs Documentation" sourceRef="t14" targetRef="se15"/>
    <bpmn:messageFlow id="mf14" name="Order Dispatched" sourceRef="t15" targetRef="ice5"/>
    <bpmn:messageFlow id="mf15" name="Shipping Confirmation" sourceRef="t16" targetRef="ice6"/>
    <bpmn:messageFlow id="mf16" name="Inventory Updated" sourceRef="t17" targetRef="ice7"/>
    <bpmn:messageFlow id="mf17" name="Feedback Sent" sourceRef="t18" targetRef="ice8"/>
    <bpmn:messageFlow id="mf18" name="Issue Reported" sourceRef="t19" targetRef="se20"/>
    <bpmn:messageFlow id="mf19" name="Return Label" sourceRef="t20" targetRef="ice9"/>
    <bpmn:messageFlow id="mf20" name="Items Received" sourceRef="t21" targetRef="ice10"/>
    <bpmn:messageFlow id="mf21" name="Items Inspected" sourceRef="t22" targetRef="ice11"/>
    <bpmn:messageFlow id="mf22" name="Refund/Replacement" sourceRef="t23" targetRef="ice12"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Start"/>
    <bpmn:task id="t1" name="Place Order"/>
    <bpmn:intermediateCatchEvent id="ice2" name="Payment Failed">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Payment Confirmed">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="End"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice2" targetRef="ee1"/>
  
    <bpmn:sequenceFlow id="auto_link_out_ice3_to_ee1" sourceRef="ice3" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="SystemProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Order Received">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:startEvent>
    <bpmn:task id="t3" name="Process Payment"/>
    <bpmn:exclusiveGateway id="g1" name="Payment Result"/>
    <bpmn:task id="t4" name="Notify Customer"/>
    <bpmn:endEvent id="ee2" name="Payment Processed"/>
    <bpmn:sequenceFlow id="f4" sourceRef="se2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t3" targetRef="g1"/>
    <bpmn:sequenceFlow id="f6" sourceRef="g1" targetRef="t4"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="ee2"/>
    
  </bpmn:process>
  <bpmn:process id="InventorySystemProcess" isExecutable="false">
    <bpmn:startEvent id="se6" name="Stock Check">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:startEvent>
    <bpmn:task id="t5" name="Check Stock Availability"/>
    <bpmn:exclusiveGateway id="g2" name="Stock Status"/>
    <bpmn:task id="t6" name="Initiate Back Order"/>
    <bpmn:task id="t7" name="Notify Customer of Delay"/>
    <bpmn:task id="t8" name="Wait for Back Order"/>
    <bpmn:task id="t9" name="Confirm Items Available"/>
    <bpmn:endEvent id="ee3" name="Stock Available"/>
    <bpmn:sequenceFlow id="f9" sourceRef="se6" targetRef="t5"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t5" targetRef="g2"/>
    <bpmn:sequenceFlow id="f11" sourceRef="g2" targetRef="t6"/>
    <bpmn:sequence
</think>


    <bpmn:sequenceFlow id="auto_link_out_t6_to_t7" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="auto_link_out_t7_to_t8" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="auto_link_out_t8_to_t9" sourceRef="t8" targetRef="t9"/>
    <bpmn:sequenceFlow id="auto_link_out_t9_to_ee3" sourceRef="t9" targetRef="ee3"/>
  </bpmn:process>
  <bpmn:process id="WarehouseProcess" isExecutable="false">
    <bpmn:startEvent id="se9" name="Items Available">
      <bpmn:messageEventDefinition id="med9"/>
    </bpmn:startEvent>
    <bpmn:task id="t9_dup2" name="Pick Items from Warehouse"/>
    <bpmn:task id="t10" name="Quality Control Check"/>
    <bpmn:task id="t11" name="Packaging"/>
    <bpmn:task id="t12" name="Gift Wrap if Requested"/>
    <bpmn:endEvent id="ee4" name="Packaging Complete"/>
    <bpmn:sequenceFlow id="f13" sourceRef="se9" targetRef="t9"/>
    <bpmn:sequenceFlow id="f14" sourceRef="t9" targetRef="t10"/>
    <bpmn:sequenceFlow id="f15" sourceRef="t10" targetRef="t11"/>
    <bpmn:sequenceFlow id="f16" sourceRef="t11" targetRef="t12"/>
    <bpmn:sequenceFlow id="f17" sourceRef="t12" targetRef="ee4"/>
  </bpmn:process>
  <bpmn:process id="PackagingProcess" isExecutable="false">
    <bpmn:startEvent id="se13" name="Packaging Started">
      <bpmn:messageEventDefinition id="med13"/>
    </bpmn:startEvent>
    <bpmn:task id="t12_dup2" name="Gift Wrap if Requested"/>
    <bpmn:endEvent id="ee5" name="Packaging Complete"/>
    <bpmn:sequenceFlow id="f18" sourceRef="se13" targetRef="t12"/>
    <bpmn:sequenceFlow id="f19" sourceRef="t12" targetRef="ee5"/>
  </bpmn:process>
  <bpmn:process id="ShippingDepartmentProcess" isExecutable="false">
    <bpmn:startEvent id="se14" name="Shipping Documents Ready">
      <bpmn:messageEventDefinition id="med14"/>
    </bpmn:startEvent>
    <bpmn:task id="t13" name="Prepare Shipping Documents"/>
    <bpmn:task id="t14" name="Prepare Customs Documentation"/>
    <bpmn:task id="t15" name="Dispatch Order"/>
    <bpmn:endEvent id="ee6" name="Order Dispatched"/>
    <bpmn:sequenceFlow id="f20" sourceRef="se14" targetRef="t13"/>
    <bpmn:sequenceFlow id="f21" sourceRef="t13" targetRef="t14"/>
    <bpmn:sequenceFlow id="f22" sourceRef="t14" targetRef="t15"/>
    <bpmn:sequenceFlow id="f23" sourceRef="t15" targetRef="ee6"/>
  </bpmn:process>
  <bpmn:process id="ReturnsDepartmentProcess" isExecutable="false">
    <bpmn:startEvent id="se20" name="Issue Reported">
      <bpmn:messageEventDefinition id="med20"/>
    </bpmn:startEvent>
    <bpmn:task id="t19" name="Send Return Label"/>
    <bpmn:task id="t20" name="Receive Returned Items"/>
    <bpmn:task id="t21" name="Inspect Returned Items"/>
    <bpmn:task id="t22" name="Process Refund or Replacement"/>
    <bpmn:endEvent id="ee7" name="Returns Processed"/>
    <bpmn:sequenceFlow id="f24" sourceRef="se20" targetRef="t19"/>
    <bpmn:sequenceFlow id="f25" sourceRef="t19" targetRef="t20"/>
    <bpmn:sequenceFlow id="f26" sourceRef="t20" targetRef="t21"/>
    <bpmn:sequenceFlow id="f27" sourceRef="t21" targetRef="t22"/>
    <bpmn:sequenceFlow id="f28" sourceRef="t22" targetRef="ee7"/>
  </bpmn:process>
</bpmn:definitions>