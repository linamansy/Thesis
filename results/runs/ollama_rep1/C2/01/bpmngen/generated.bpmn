      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice1_dup2" bpmnElement="ice1">
        <dc:Bounds x="400" y="180" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="f1_dup2" bpmnElement="f1">
        <dc:Bounds x="136" y="100" width="10" height="10"/>
        <di:waypoint x="136" y="100"/>
        <di:waypoint x="146" y="100"/>
      </bpmndi:BPMNShape>
