<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Order Management System" processRef="OrderManagementProcess"/>
    <bpmn:participant id="p2" name="Stock Management System" processRef="StockManagementProcess"/>
    <bpmn:participant id="p3" name="Wholesaler" processRef="WholesalerProcess"/>
    <bpmn:participant id="p4" name="Courier Service" processRef="CourierServiceProcess"/>
    <bpmn:messageFlow id="mf1" name="Order Read" sourceRef="se1" targetRef="t1"/>
    <bpmn:messageFlow id="mf2" name="Product In Stock" sourceRef="t2" targetRef="ice1"/>
    <bpmn:messageFlow id="mf3" name="Product Not In Stock" sourceRef="t2" targetRef="ice2"/>
    <bpmn:messageFlow id="mf4" name="Product Reordered" sourceRef="t3" targetRef="ice3"/>
    <bpmn:messageFlow id="mf5" name="Product Arrived" sourceRef="t4" targetRef="se5"/>
    <bpmn:messageFlow id="mf6" name="Order Ready" sourceRef="t5" targetRef="se6"/>
    <bpmn:messageFlow id="mf7" name="Order Not Ready" sourceRef="t5" targetRef="t6"/>
    <bpmn:messageFlow id="mf8" name="Request Courier" sourceRef="t7" targetRef="se8"/>
    <bpmn:messageFlow id="mf9" name="Delivery Delay Penalty" sourceRef="ice4" targetRef="t8"/>
  </bpmn:collaboration>
  <bpmn:process id="OrderManagementProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Read Order"/>
    <bpmn:task id="t1" name="Read Order from System"/>
    <bpmn:exclusiveGateway id="g1" name="Check Product In Stock"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="g1"/>
    
    
    
    
    
    
    
    
    
  </bpmn:process>
  <bpmn:process id="StockManagementProcess" isExecutable="false">
    <bpmn:startEvent id="se5" name="Register Product"/>
    <bpmn:task id="t4" name="Register Product in Stock"/>
    <bpmn:exclusiveGateway id="g2" name="Check Order Ready"/>
    <bpmn:sequenceFlow id="f12" sourceRef="se5" targetRef="t4"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t4" targetRef="g2"/>
    
    
  </bpmn:process>
  <bpmn:process id="WholesalerProcess" isExecutable="false">
    <bpmn:startEvent id="se7" name="Reorder Product"/>
    <bpmn:intermediateCatchEvent id="ice3" name="Product Not In Stock">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t3" name="Reorder Product"/>
    <bpmn:intermediateCatchEvent id="ice4" name="Wait More Than 10 Days">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t8" name="Demand Penalty"/>
    <bpmn:endEvent id="ee1" name="Product Arrived"/>
    <bpmn:sequenceFlow id="f16" sourceRef="se7" targetRef="t3"/>
    <bpmn:sequenceFlow id="f17" sourceRef="t3" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f18" sourceRef="ice4" targetRef="t8"/>
    <bpmn:sequenceFlow id="f19" sourceRef="t8" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="CourierServiceProcess" isExecutable="false">
    <bpmn:startEvent id="se8" name="Request Courier"/>
    <bpmn:task id="t7" name="Request Courier"/>
    <bpmn:task id="t9" name="Pack Products"/>
    <bpmn:task id="t10" name="Ship Products"/>
    <bpmn:endEvent id="ee2" name="Order Shipped"/>
    <bpmn:sequenceFlow id="f20" sourceRef="se8" targetRef="t7"/>
    <bpmn:sequenceFlow id="f21" sourceRef="t7" targetRef="t9"/>
    <bpmn:sequenceFlow id="f22" sourceRef="t9" targetRef="t10"/>
    <bpmn:sequenceFlow id="f23" sourceRef="t10" targetRef="ee2"/>
  </bpmn:process>
