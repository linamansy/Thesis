<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="E-Shop System" processRef="EShopSystemProcess"/>
    <bpmn:messageFlow id="mf1" name="Login Confirmation" sourceRef="t1" targetRef="ice1"/>
    <bpmn:messageFlow id="mf2" name="Add Product" sourceRef="t2" targetRef="se2"/>
    <bpmn:messageFlow id="mf3" name="Product Selected" sourceRef="t3" targetRef="ice2"/>
    <bpmn:messageFlow id="mf4" name="Order Finished" sourceRef="t4" targetRef="ice3"/>
    <bpmn:messageFlow id="mf5" name="Payment Data" sourceRef="t5" targetRef="ice4"/>
    <bpmn:messageFlow id="mf6" name="Payment Confirmed" sourceRef="ice5" targetRef="t6"/>
    <bpmn:messageFlow id="mf7" name="Shipping Address" sourceRef="t6" targetRef="ice6"/>
    <bpmn:messageFlow id="mf8" name="Order Complete" sourceRef="ice7" targetRef="t7"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Login"/>
    <bpmn:task id="t1" name="Login Request"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Login Confirmed">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g1" name="Login Successful?"/>
    <bpmn:task id="t2" name="Select Product"/>
    <bpmn:task id="t3" name="Add to Cart"/>
    <bpmn:task id="t4" name="Save Product"/>
    <bpmn:task id="t5" name="Enter Payment Data"/>
    <bpmn:intermediateCatchEvent id="ice2" name="Product Selected">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="All Products Selected">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatch
    <bpmn:intermediateCatchEvent id="ice4" name="Payment Data Entered">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice5" name="Payment Confirmed">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice6" name="Shipping Address Entered">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice7" name="Order Complete">
      <bpmn:messageEventDefinition id="med7"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Shopping Experience Complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="g1"/>
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f8" sourceRef="ice2" targetRef="t2"/>
    <bpmn:sequenceFlow id="f9" sourceRef="ice3" targetRef="t5"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t5" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f11" sourceRef="ice4" targetRef="ice5"/>
    
    
    <bpmn:sequenceFlow id="f14" sourceRef="ice6" targetRef="ice7"/>
    <bpmn:sequenceFlow id="f15" sourceRef="ice7" targetRef="ee1"/>
  
    <bpmn:sequenceFlow id="auto_link_in_g1_to_ice3" sourceRef="g1" targetRef="ice3"/>
    <bpmn:sequenceFlow id="auto_link_out_ice5_to_ice6" sourceRef="ice5" targetRef="ice6"/>
  </bpmn:process>
  <bpmn:process id="EShopSystemProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Login Request">
      <bpmn:messageEventDefinition id="med8"/>
    </bpmn:startEvent>
    <bpmn:task id="t1_dup2" name="Check Credentials"/>
    <bpmn:exclusiveGateway id="g1_dup2" name="Login Successful?"/>
    <bpmn:task id="t2_dup2" name="Prepare Order"/>
    <bpmn:task id="t3_dup2" name="Prepare Payment"/>
    <bpmn:task id="t4_dup2" name="Prepare Shipment"/>
    <bpmn:endEvent id="ee1_dup2" name="Order Finished"/>
    <bpmn:sequenceFlow id="f1_dup2" sourceRef="se2" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2_dup2" sourceRef="t1" targetRef="g1"/>
    <bpmn:sequenceFlow id="f3_dup2" sourceRef="g1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f4_dup2" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f5_dup2" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f6_dup2" sourceRef="t4" targetRef="ee1"/>
  </bpmn:process>
