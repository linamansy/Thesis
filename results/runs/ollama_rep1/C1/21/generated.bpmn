    <bpmn:messageFlow id="mf9" name="Ready for Pickup" sourceRef="t17" targetRef="se18"/>
  </bpmn:collaboration>
  <bpmn:process id="SecretaryProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Goods to be Shipped"/>
    <bpmn:task id="t1" name="Clarify Shipping Responsibility"/>
    <bpmn:exclusiveGateway id="eg1" name="Shipping Required?"/>
    <bpmn:task id="t3" name="Check Amount Size"/>
    <bpmn:exclusiveGateway id="eg2" name="Special Shipping Needed?"/>
    <bpmn:task id="t5" name="Invite Logistic Companies"/>
    <bpmn:task id="t7" name="Select Logistic Company"/>
    <bpmn:task id="t9" name="Normal Post Shipment"/>
    <bpmn:task id="t11" name="Write Package Label"/>
    <bpmn:task id="t13" name="Take Parcel Insurance"/>
    <bpmn:task id="t15" name="Goods Packaged"/>
    <bpmn:task id="t17" name="Prepare for Pickup"/>
    <bpmn:endEvent id="ee1" name="Process Complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="eg1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="eg1" targetRef="t3"/>
