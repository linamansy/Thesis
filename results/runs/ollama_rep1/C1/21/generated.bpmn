    <bpmn:sequenceFlow id="f11" sourceRef="t15" targetRef="t17"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t17" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="LogisticsDepartmentHeadProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Special Shipping Needed"/>
    <bpmn:task id="t2" name="Take Parcel Insurance"/>
    <bpmn:endEvent id="ee2" name="Insurance Taken"/>
    <bpmn:sequenceFlow id="f13" sourceRef="se2" targetRef="t2"/>
    <bpmn:sequenceFlow id="f14" sourceRef="t2" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="WarehousemenProcess" isExecutable="false">
