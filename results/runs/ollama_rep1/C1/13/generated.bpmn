<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="Customer Service" processRef="CustomerServiceProcess"/>
    <bpmn:participant id="p3" name="Complaint Team" processRef="ComplaintTeamProcess"/>
    <bpmn:participant id="p4" name="Financial Team" processRef="FinancialTeamProcess"/>
    <bpmn:messageFlow id="mf1" name="File Complaint" sourceRef="se1" targetRef="t1"/>
    <bpmn:messageFlow id="mf2" name="Complaint Assigned" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf3" name="Complaint Validated" sourceRef="t3" targetRef="ice1"/>
    <bpmn:messageFlow id="mf4" name="Refund Decision" sourceRef="t4" targetRef="ice2"/>
    <bpmn:messageFlow id="mf5" name="Refund Approved" sourceRef="t5" targetRef="se3"/>
    <bpmn:messageFlow id="mf6" name="Refund Processed" sourceRef="t6" targetRef="ice3"/>
    <bpmn:messageFlow id="mf7" name="Feedback Provided" sourceRef="t7" targetRef="ee1"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="File Complaint"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Complaint Validated">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Refund Decision">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Refund Processed">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Feedback Provided"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="ice1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice2" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f4" sourceRef="ice3" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="CustomerServiceProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Complaint Received">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Log Complaint"/>
    <bpmn:task id="t2" name="Assign to Department"/>
    <bpmn:endEvent id="ee2" name="Complaint Assigned"/>
    <bpmn:sequenceFlow id="f5" sourceRef="se2" targetRef="t1"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t2" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="ComplaintTeamProcess" isExecutable="false">
    <bpmn:startEvent id="se3" name="Complaint Assigned">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:startEvent>
    <bpmn:task id="t3" name="Review Details"/>
    <bpmn:exclusiveGateway id="g1" name="Validated?"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t3" targetRef="g1"/>
    <bpmn:sequenceFlow id="f9" sourceRef="g1" targetRef="t4"/>
    
    <bpmn:task id="t4" name="Determine Refund"/>
    <bpmn:endEvent id="ee3" name="Decision Notified"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t4" targetRef="ee3"/>
  
    <bpmn:sequenceFlow id="auto_link_out_se3_to_t3" sourceRef="se3" targetRef="t3"/>
  </bpmn:process>
  <bpmn:process id="FinancialTeamProcess" isExecutable="false">
    <bpmn:startEvent id="se4" name="Refund Approved">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:startEvent>
    <bpmn:task id="t5" name="Process Refund"/>
    <bpmn:intermediateCatchEvent id="ice4" name="Refund Processed">
      <bpmn:messageEventDefinition id="med7"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee4" name="Refund Completed"/>
    <bpmn:sequenceFlow id="f12" sourceRef="se4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t5" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f14" sourceRef="ice4" targetRef="ee4"/>
  </bpmn:process>
</bpmn:definitions>