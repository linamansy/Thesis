      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_6" bpmnElement="ee2">
        <dc:Bounds x="680" y="260" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_dup2" bpmnElement="EmployeeProcess">
        <dc:Bounds x="0" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_dup2" bpmnElement="ITProcess">
        <dc:Bounds x="0" y="260" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_dup2" sourceRef="se1" targetRef="t1">
        <di:waypoint x="180" y="150"/>
        <di:waypoint x="280" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_dup2" sourceRef="t1" targetRef="ice1">
        <di:waypoint x="380" y="150"/>
        <di:waypoint x="400" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_dup2" sourceRef="ice1" targetRef="ee1">
        <di:waypoint x="500" y="150"/>
        <di:waypoint x="520" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_dup2" sourceRef="se2" targetRef="t3">
        <di:waypoint x="180" y="310"/>
        <di:waypoint x="280" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_dup2" sourceRef="t3" targetRef="t4">
        <di:waypoint x="380" y="310"/>
        <di:waypoint x="380" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_dup2" sourceRef="t4" targetRef="t5">
        <di:waypoint x="480" y="310"/>
        <di:waypoint x="480" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_dup2" sourceRef="t5" targetRef="t6">
        <di:waypoint x="580" y="310"/>
        <di:waypoint x="580" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_dup2" sourceRef="t6" targetRef="ee2">
        <di:waypoint x="680" y="310"/>
        <di:waypoint x="680" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf1_dup2" sourceRef="t1" targetRef="se2">
        <di:waypoint x="380" y="150"/>
        <di:waypoint x="180" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf2_dup2" sourceRef="ice1" targetRef="t3">
        <di:waypoint x="500" y="150"/>
        <di:waypoint x="380" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf3_dup2" sourceRef="ee1" targetRef="t5">
