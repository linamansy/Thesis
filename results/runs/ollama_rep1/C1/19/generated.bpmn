  <bpmn:process id="OnlineShopProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Login Request">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="ice1" name="Order Confirmed">
