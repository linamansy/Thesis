    <bpmn:messageFlow id="mf13" name="New Delivery" sourceRef="t13" targetRef="se16"/>
  </bpmn:collaboration>
  <bpmn:process id="UserProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Start Process"/>
    <bpmn:task id="t1" name="Login"/>
    <bpmn:parallelGateway id="pg1" name="Parallel Gateway"/>
    <bpmn:task id="t2" name="Select Items"/>
    <bpmn:task id="t3" name="Set Payment Method"/>
    <bpmn:exclusiveGateway id="eg1" name="Payment Decision"/>
    <bpmn:task id="t4" name="Pay"/>
    <bpmn:task id="t5" name="Complete Installment Agreement"/>
    <bpmn:task id="t6" name="Choose Reward"/>
