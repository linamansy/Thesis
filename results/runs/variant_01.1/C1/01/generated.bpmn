<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="Sales Staff" processRef="SalesProcess"/>
    <bpmn:messageFlow id="mf1" name="Inquiry" sourceRef="se1" targetRef="t1"/>
    <bpmn:messageFlow id="mf2" name="Information" sourceRef="t1" targetRef="t2"/>
    <bpmn:messageFlow id="mf3" name="Quote" sourceRef="t2" targetRef="ice1"/>
    <bpmn:messageFlow id="mf4" name="Approval" sourceRef="ice1" targetRef="t3"/>
    <bpmn:messageFlow id="mf5" name="Order" sourceRef="t3" targetRef="se2"/>
    <bpmn:messageFlow id="mf6" name="Confirmation" sourceRef="se2" targetRef="ice2"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Inquiry"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Quote Approved">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Order Confirmed">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Order Complete"/>
    
    
    
    
    
    <bpmn:sequenceFlow id="f6" sourceRef="ice2" targetRef="ee1"/>
  
    <bpmn:sequenceFlow id="auto_link_out_se1_to_ice2" sourceRef="se1" targetRef="ice2"/>
  </bpmn:process>
  <bpmn:process id="SalesProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Order Received">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Collect Information"/>
    <bpmn:task id="t2" name="Address Concerns"/>
    <bpmn:task id="t3" name="Provide Quote"/>
    <bpmn:task id="t4" name="Record Order"/>
    <bpmn:endEvent id="ee2" name="Done"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se2" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t4" targetRef="ee2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collab1">
      <bpmndi:BPMNShape id="CustomerProcess_1" bpmnElement="CustomerProcess">
        <dc:Bounds x="100" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SalesProcess_1" bpmnElement="SalesProcess">
        <dc:Bounds x="300" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se1_1" bpmnElement="se1">
        <dc:Bounds x="100" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_1" bpmnElement="t1">
        <dc:Bounds x="200" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_1" bpmnElement="t2">
        <dc:Bounds x="300" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice1_1" bpmnElement="ice1">
        <dc:Bounds x="400" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_1" bpmnElement="t3">
        <dc:Bounds x="500" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice2_1" bpmnElement="ice2">
        <dc:Bounds x="600" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee1_1" bpmnElement="ee1">
        <dc:Bounds x="700" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se2_1" bpmnElement="se2">
        <dc:Bounds x="300" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_2" bpmnElement="t1">
        <dc:Bounds x="300" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_2" bpmnElement="t2">
        <dc:Bounds x="300" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_2" bpmnElement="t3">
        <dc:Bounds x="300" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_1" bpmnElement="t4">
        <dc:Bounds x="300" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee2_1" bpmnElement="ee2">
        <dc:Bounds x="300" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_1" bpmnElement="f1">
        <di:waypoint x="100" y="140"/>
        <di:waypoint x="200" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_1" bpmnElement="f2">
        <di:waypoint x="200" y="140"/>
        <di:waypoint x="300" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_1" bpmnElement="f3">
        <di:waypoint x="300" y="140"/>
        <di:waypoint x="400" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_1" bpmnElement="f4">
        <di:waypoint x="400" y="140"/>
        <di:waypoint x="500" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_1" bpmnElement="f5">
