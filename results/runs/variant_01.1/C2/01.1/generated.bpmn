<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="Sales Staff" processRef="SalesProcess"/>
    <bpmn:participant id="p3" name="System" processRef="SystemProcess"/>
    <bpmn:messageFlow id="mf1" name="Inquiry" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Customer Info" sourceRef="t2" targetRef="se3"/>
    <bpmn:messageFlow id="mf3" name="Product Selection" sourceRef="t3" targetRef="se4"/>
    <bpmn:messageFlow id="mf4" name="Quote" sourceRef="t4" targetRef="se5"/>
    <bpmn:messageFlow id="mf5" name="Quote Approval" sourceRef="t5" targetRef="se6"/>
    <bpmn:messageFlow id="mf6" name="Order Confirmation" sourceRef="t6" targetRef="se7"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Inquiry"/>
    <bpmn:task id="t1" name="Inquire About Product or Service"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Customer Info Collected">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Product Selected">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Quote Received">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice4" name="Quote Approved">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice5" name="Order Confirmed">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Order Placed and Confirmed"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="ice2" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="ice3" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f6" sourceRef="ice4" targetRef="ice5"/>
    <bpmn:sequenceFlow id="f7" sourceRef="ice5" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="SalesProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Inquiry Received">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:startEvent>
    <bpmn:task id="t2" name="Collect Customer Info"/>
    <bpmn:task id="t3" name="Guide to Product Selection"/>
    <bpmn:task id="t4" name="Provide Quote"/>
    <bpmn:task id="t5" name="Wait for Quote Approval"/>
    <bpmn:intermediateCatchEvent id="ice6" name="Order Placed">
      <bpmn:messageEventDefinition id="med7"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee2" name="Order Confirmed"/>
    <bpmn:sequenceFlow id="f8" sourceRef="se2" targetRef="t2"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t5" targetRef="ice6"/>
    <bpmn:sequenceFlow id="f13" sourceRef="ice6" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="SystemProcess" isExecutable="false">
    <bpmn:startEvent id="se3" name="Customer Info Received">
      <bpmn:messageEventDefinition id="med8"/>
    </bpmn:startEvent>
    <bpmn:task id="t6" name="Store Customer Info"/>
    <bpmn:intermediateCatchEvent id="ice7" name="Product Selected">
      <bpmn:messageEventDefinition id="med9"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatch, id="ice8" name="Quote Approved">
      <bpmn:messageEventDefinition id="med10"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice9" name="Order Confirmed">
      <bpmn:messageEventDefinition id="med11"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee3" name="Order Confirmed"/>
    <bpmn:sequenceFlow id="f14" sourceRef="se3" targetRef="t6"/>
    <bpmn:sequenceFlow id="f15" sourceRef="t6" targetRef="ice7"/>
    <bpmn:sequenceFlow id="f16" sourceRef="ice7" targetRef="ice8"/>
    <bpmn:sequenceFlow id="f17" sourceRef="ice8" targetRef="ice9"/>
    <bpmn:sequenceFlow id="f18" sourceRef="ice9" targetRef="ee3"/>
  </bpmn:process>
