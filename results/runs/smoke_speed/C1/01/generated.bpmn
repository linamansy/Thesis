<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="Sales" processRef="SalesProcess"/>
    <bpmn:messageFlow id="mf1" name="Inquiry" sourceRef="se1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Order Confirmation" sourceRef="t7" targetRef="ice1"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Inquire"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Order Confirmation">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Order Complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="ice1" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="SalesProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Start Sales Process">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Collect Information"/>
    <bpmn:exclusiveGateway id="g1" name="Is Interested?"/>
    <bpmn:task id="t2" name="Select Product"/>
    <bpmn:task id="t3" name="Provide Quote"/>
    <bpmn:task id="t4" name="Approval"/>
    <bpmn:task id="t5" name="Order Placement"/>
    <bpmn:endEvent id="ee2" name="Done"/>
    <bpmn:sequenceFlow id="f3" sourceRef="se2" targetRef="t1"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t1" targetRef="g1"/>
    <bpmn:sequenceFlow id="f5" sourceRef="g1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="ee2"/>
  </bpmn:process>
</bpmn:definitions>