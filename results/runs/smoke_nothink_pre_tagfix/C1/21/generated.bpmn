<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Secretary" processRef="SecretaryProcess"/>
    <bpmn:participant id="p2" name="Logistics Department Head" processRef="LogisticsDepartmentHeadProcess"/>
    <bpmn:participant id="p3" name="Warehousemen" processRef="WarehousemenProcess"/>
    <bpmn:messageFlow id="mf1" name="Shipping Required" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Special Shipping Needed" sourceRef="t2" targetRef="se3"/>
    <bpmn:messageFlow id="mf3" name="Select Logistics Company" sourceRef="t4" targetRef="se5"/>
    <bpmn:messageFlow id="mf4" name="Normal Post Shipment" sourceRef="t5" targetRef="se6"/>
    <bpmn:messageFlow id="mf5" name="Package Label" sourceRef="t7" targetRef="se8"/>
    <bpmn:messageFlow id="mf6" name="Parcel Insurance" sourceRef="t8" targetRef="se9"/>
    <bpmn:messageFlow id="mf7" name="Packaged Goods Ready" sourceRef="t10" targetRef="se11"/>
  </bpmn:collaboration>
  <bpmn:process id="SecretaryProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Goods to be Shipped"/>
    <bpmn:task id="t1" name="Clarify Shipping Responsibility"/>
    <bpmn:exclusiveGateway id="eg1" name="Shipping Type"/>
    <bpmn:task id="t2" name="Check Amount Size"/>
    <bpmn:exclusiveGateway id="eg2" name="Shipping Type Decision"/>
    <bpmn:task id="t3" name="Invite Logistic Companies"/>
    <bpmn:task id="t4" name="Select Logistics Company"/>
    <bpmn:task id="t5" name="Normal Post Shipment"/>
    <bpmn:task id="t6" name="Prepare Package Label"/>
    <bpmn:task id="t7" name="Write Package Label"/>
    <bpmn:task id="t8" name="Take Parcel Insurance"/>
    <bpmn:task id="t9" name="Packaged Goods Ready"/>
    <bpmn:endEvent id="ee1" name="Goods Prepared for Pickup"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="eg1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="eg1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t2" targetRef="eg2"/>
    <bpmn:sequenceFlow id="f5" sourceRef="eg2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t8" targetRef="t9"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t9" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="LogisticsDepartmentHeadProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Special Shipping Needed"/>
    <bpmn:task id="t3_dup2" name="Take Parcel Insurance"/>
    <bpmn:endEvent id="ee2" name="Insurance Taken"/>
    <bpmn:sequenceFlow id="f13" sourceRef="se2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f14" sourceRef="t3" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="WarehousemenProcess" isExecutable="false">
    <bpmn:startEvent id="se3" name="Packaged Goods Ready"/>
    <bpmn:task id="t4_dup2" name="Packaged Goods Ready"/>
    <bpmn:endEvent id="ee3" name="Goods Ready for Pickup"/>
    <bpmn:sequenceFlow id="f15" sourceRef="se3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f16" sourceRef="t4" targetRef="ee3"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram1">
