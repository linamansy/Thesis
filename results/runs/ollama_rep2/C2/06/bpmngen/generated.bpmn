      <bpmndi:BPMNShape id="ice4_dup2" bpmnElement="ice4">
        <dc:Bounds x="160" y="280" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee1_dup2" bpmnElement="ee1">
        <dc:Bounds x="20" y="360" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se2_dup2" bpmnElement="se2">
        <dc:Bounds x="20" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_dup2" bpmnElement="t3">
        <dc:Bounds x="80" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice5_dup2" bpmnElement="ice5">
        <dc:Bounds x="160" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee2_dup2" bpmnElement="ee2">
        <dc:Bounds x="20" y="300" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se4_dup2" bpmnElement="se4">
        <dc:Bounds x="20" y="320" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_dup2" bpmnElement="t5">
        <dc:Bounds x="80" y="320" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_dup2" bpmnElement="t6">
        <dc:Bounds x="80" y="400" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee3_dup2" bpmnElement="ee3">
        <dc:Bounds x="20" y="480" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se5_dup2" bpmnElement="se5">
        <dc:Bounds x="20" y="520" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_dup2" bpmnElement="t7">
        <dc:Bounds x="80" y="520" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice6_dup2" bpmnElement="ice6">
        <dc:Bounds x="160" y="520" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_dup2" bpmnElement="t8">
        <dc:Bounds x="80" y="600" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice7_dup2" bpmnElement="ice7">
        <dc:Bounds x="160" y="600" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee4_dup2" bpmnElement="ee4">
        <dc:Bounds x="20" y="680" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_dup2" sourceRef="se1" targetRef="t1">
        <di:waypoint x="20" y="10"/>
        <di:waypoint x="80" y="10"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_dup2" sourceRef="t1" targetRef="ice1">
        <di:waypoint x="160" y="10"/>
        <di:waypoint x="160" y="10"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_dup2" sourceRef="ice1" targetRef="ice2">
        <di:waypoint x="160" y="10"/>
        <di:waypoint x="160" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_dup2" sourceRef="ice2" targetRef="ice3">
        <di:waypoint x="160" y="190"/>
        <di:waypoint x="160" y="190"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_dup2" sourceRef="ice3" targetRef="ice4">
        <di:waypoint x="160" y="280"/>
        <di:waypoint x="160" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_dup2" sourceRef="ice4" targetRef="ee1">
