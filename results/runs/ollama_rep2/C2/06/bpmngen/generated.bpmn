        <di:waypoint x="20" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_dup2" sourceRef="se2" targetRef="t3">
        <di:waypoint x="20" y="200"/>
        <di:waypoint x="80" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_dup2" sourceRef="t3" targetRef="ice5">
