        <di:waypoint x="80" y="600"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f16_dup2" sourceRef="t8" targetRef="ice7">
        <di:waypoint x="160" y="600"/>
        <di:waypoint x="160" y="600"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f17_dup2" sourceRef="ice7" targetRef="ee4">
