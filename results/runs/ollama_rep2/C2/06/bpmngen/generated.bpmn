<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="System" processRef="SystemProcess"/>
    <bpmn:participant id="p3" name="Warehouse" processRef="WarehouseProcess"/>
    <bpmn:participant id="p4" name="Logistics" processRef="LogisticsProcess"/>
    <bpmn:messageFlow id="mf1" name="Place Order" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Order Confirmation" sourceRef="t3" targetRef="ice1"/>
    <bpmn:messageFlow id="mf3" name="Order Picked" sourceRef="t5" targetRef="se4"/>
    <bpmn:messageFlow id="mf4" name="Shipping Label" sourceRef="t6" targetRef="se5"/>
    <bpmn:messageFlow id="mf5" name="Tracking Info" sourceRef="t8" targetRef="ice2"/>
    <bpmn:messageFlow id="mf6" name="Delivery Complete" sourceRef="t10" targetRef="ice3"/>
    <bpmn:messageFlow id="mf7" name="Feedback/Return" sourceRef="t11" targetRef="ice4"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Hungry"/>
    <bpmn:task id="t1" name="Place Order"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Order Confirmed">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Order Picked">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Delivery Complete">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice4" name="Feedback/Return">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Order Complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="ice2" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="ice3" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f6" sourceRef="ice4" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="SystemProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Order Received">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:startEvent>
    <bpmn:task id="t3" name="Generate Order Confirmation"/>
    <bpmn:intermediateCatchEvent id="ice5" name="Payment Acknowledged">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee2" name="Order Confirmed"/>
    <bpmn:sequenceFlow id="f7" sourceRef="se2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t3" targetRef="ice5"/>
    <bpmn:sequenceFlow id="f9" sourceRef="ice5" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="WarehouseProcess" isExecutable="false">
    <bpmn:startEvent id="se4" name="Order Picked">
      <bpmn:messageEventDefinition id="med7"/>
    </bpmn:startEvent>
    <bpmn:task id="t5" name="Pick and Pack Items"/>
    <bpmn:task id="t6" name="Generate Shipping Label"/>
    <bpmn:endEvent id="ee3" name="Order Ready for Shipping"/>
    <bpmn:sequenceFlow id="f10" sourceRef="se4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t6" targetRef="ee3"/>
  </bpmn:process>
  <bpmn:process id="LogisticsProcess" isExecutable="false">
    <bpmn:startEvent id="se5" name="Order Shipped">
      <bpmn:messageEventDefinition id="med8"/>
    </bpmn:startEvent>
    <bpmn:task id="t7" name="Ship Order"/>
    <bpmn:intermediateCatchEvent id="ice6" name="Tracking Info Sent">
      <bpmn:messageEventDefinition id="med9"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t8" name="Monitor Shipment"/>
    <bpmn:intermediateCatchEvent id="ice7" name="Delivery Complete">
      <bpmn:messageEvent than="med10"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee4" name="Delivery Complete"/>
    <bpmn:sequenceFlow id="f13" sourceRef="se5" targetRef="t7"/>
    <bpmn:sequenceFlow id="f14" sourceRef="t7" targetRef="ice6"/>
    <bpmn:sequenceFlow id="f15" sourceRef="ice6" targetRef="t8"/>
    <bpmn:sequenceFlow id="f16" sourceRef="t8" targetRef="ice7"/>
    <bpmn:sequenceFlow id="f17" sourceRef="ice7" targetRef="ee4"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram1">
    <bpmndi:BPMNPlane id="BPMNPlane1" bpmnElement="collab1">
      <bpmndi:BPMNShape id="p1_dup2" bpmnElement="Customer" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_dup2" bpmnElement="System" isHorizontal="true">
        <dc:Bounds x="0" y="160" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p3_dup2" bpmnElement="Warehouse" isHorizontal="true">
        <dc:Bounds x="0" y="320" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p4_dup2" bpmnElement="Logistics" isHorizontal="true">
        <dc:Bounds x="0" y="480" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se1_dup2" bpmnElement="se1">
        <dc:Bounds x="20" y="10" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_dup2" bpmnElement="t1">
        <dc:Bounds x="80" y="10" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice1_dup2" bpmnElement="ice1">
        <dc:Bounds x="160" y="10" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice2_dup2" bpmnElement="ice2">
