        <di:waypoint x="20" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_dup2" sourceRef="se5" targetRef="t7">
        <di:waypoint x="20" y="520"/>
        <di:waypoint x="80" y="520"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f14_dup2" sourceRef="t7" targetRef="ice6">
        <di:waypoint x="160" y="520"/>
        <di:waypoint x="160" y="520"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f15_dup2" sourceRef="ice6" targetRef="t8">
