<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="Sales Staff" processRef="SalesProcess"/>
    <bpmn:messageFlow id="mf1" name="Inquiry" sourceRef="se1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Information" sourceRef="t1" targetRef="se3"/>
    <bpmn:messageFlow id="mf3" name="Quote" sourceRef="t2" targetRef="ice1"/>
    <bpmn:messageFlow id="mf4" name="Approval" sourceRef="ice2" targetRef="t3"/>
    <bpmn:messageFlow id="mf5" name="Order Confirmation" sourceRef="t4" targetRef="ice3"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Inquiry"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Quote Received">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Quote Approved">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Order Confirmed">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Order Complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="ice1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice2" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f4" sourceRef="ice3" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="SalesProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Inquiry Received">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Collect Information"/>
    <bpmn:task id="t2" name="Provide Quote"/>
    <bpmn:intermediateCatchEvent id="ice4" name="Order Approved">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t3" name="Place Order"/>
    <bpmn:intermediateCatchEvent id="ice5" name="Order Confirmed">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee2" name="Order Processed"/>
    <bpmn:sequenceFlow id="f5" sourceRef="se2" targetRef="t1"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t2" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f8" sourceRef="ice4" targetRef="t3"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t3" targetRef="ice5"/>
    <bpmn:sequenceFlow id="f10" sourceRef="ice5" targetRef="ee2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram1">
    <bpmndi:BPMNPlane id="BPMNPlane1" bpmnElement="collab1">
      <bpmndi:BPMNShape id="CustomerProcess_1" bpmnElement="se1">
        <dc:Bounds x="100" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CustomerProcess_2" bpmnElement="ice1">
        <dc:Bounds x="100" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CustomerProcess_3" bpmnElement="ice2">
        <dc:Bounds x="100" y="300" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CustomerProcess_4" bpmnElement="ice3">
        <dc:Bounds x="100" y="400" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CustomerProcess_5" bpmnElement="ee1">
        <dc:Bounds x="100" y="500" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SalesProcess_1" bpmnElement="se2">
        <dc:Bounds x="300" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SalesProcess_2" bpmnElement="t1">
        <dc:Bounds x="300" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SalesProcess_3" bpmnElement="t2">
        <dc:Bounds x="300" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SalesProcess_4" bpmnElement="ice4">
        <dc:Bounds x="300" y="400" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SalesProcess_5" bpmnElement="t3">
        <dc:Bounds x="300" y="500" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SalesProcess_6" bpmnElement="ice5">
        <dc:Bounds x="300" y="600" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SalesProcess_7" bpmnElement="ee2">
        <dc:Bounds x="300" y="700" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_dup2" sourceRef="se1" targetRef="ice1">
        <di:waypoint x="200" y="100"/>
        <di:waypoint x="100" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_dup2" sourceRef="ice1" targetRef="ice2">
        <di:waypoint x="100" y="200"/>
        <di:waypoint x="100" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_dup2" sourceRef="ice2" targetRef="ice3">
        <di:waypoint x="100" y="300"/>
        <di:waypoint x="100" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_dup2" sourceRef="ice3" targetRef="ee1">
        <di:waypoint x="100" y="400"/>
        <di:waypoint x="100" y="500"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_dup2" sourceRef="se2" targetRef="t1">
        <di:waypoint x="400" y="100"/>
        <di:waypoint x="300" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_dup2" sourceRef="t1" targetRef="t2">
        <di:waypoint x="300" y="200"/>
        <di:waypoint x="300" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_dup2" sourceRef="t2" targetRef="ice4">
        <di:waypoint x="300" y="300"/>
        <di:waypoint x="300" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_dup2" sourceRef="ice4" targetRef="t3">
        <di:waypoint x="300" y="400"/>
        <di:waypoint x="300" y="500"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_dup2" sourceRef="t3" targetRef="ice5">
        <di:waypoint x="300" y="500"/>
        <di:waypoint x="300" y="600"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_dup2" sourceRef="ice5" targetRef="ee2">
        <di:waypoint x="300" y="600"/>
        <di:waypoint x="300" y="700"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="p1_dup2" bpmnElement="Customer">
        <dc:Bounds x="100" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_dup2" bpmnElement="Sales Staff">
        <dc:Bounds x="300" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mf1_dup2" bpmnElement="Inquiry">
        <dc:Bounds x="200" y="100" width="100" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mf2_dup2" bpmnElement="Information">
        <dc:Bounds x="200" y="200" width="100" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mf3_dup2" bpmnElement="Quote">
        <dc:Bounds x="200" y="300" width="100" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mf4_dup2" bpmnElement="Approval">
        <dc:Bounds x="200" y="400" width="100" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mf5_dup2" bpmnElement="Order Confirmation">
        <dc:Bounds x="200" y="500" width="100" height="36"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>