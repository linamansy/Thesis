      <bpmndi:BPMNShape id="ee3_shape" bpmnElement="ee3">
        <dc:Bounds x="1120" y="320" width="100" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_dup2" sourceRef="se1" targetRef="t1">
        <di:waypoint x="120" y="120"/>
        <di:waypoint x="240" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_dup2" sourceRef="t1" targetRef="eg1">
        <di:waypoint x="240" y="120"/>
        <di:waypoint x="360" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_dup2" sourceRef="eg1" targetRef="t2">
        <di:waypoint x="360" y="120"/>
