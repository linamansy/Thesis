<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Secretary" processRef="SecretaryProcess"/>
    <bpmn:participant id="p2" name="Logistics Department Head" processRef="LogisticsDepartmentHeadProcess"/>
    <bpmn:participant id="p3" name="Warehousemen" processRef="WarehousemenProcess"/>
    <bpmn:messageFlow id="mf1" name="Shipping Required" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Special Shipping" sourceRef="t2" targetRef="se3"/>
    <bpmn:messageFlow id="mf3" name="Offer Invited" sourceRef="t3" targetRef="se4"/>
    <bpmn:messageFlow id="mf4" name="Offer Selected" sourceRef="t4" targetRef="se5"/>
    <bpmn:messageFlow id="mf5" name="Normal Post" sourceRef="t5" targetRef="se6"/>
    <bpmn:messageFlow id="mf6" name="Label Written" sourceRef="t6" targetRef="se7"/>
    <bpmn:messageFlow id="mf7" name="Insurance Taken" sourceRef="t7" targetRef="se8"/>
    <bpmn:messageFlow id="mf8" name="Packaged" sourceRef="t8" targetRef="se9"/>
    <bpmn:messageFlow id="mf9" name="Ready" sourceRef="t9" targetRef="se10"/>
  </bpmn:collaboration>
  <bpmn:process id="SecretaryProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Goods Shipped"/>
    <bpmn:task id="t1" name="Clarify Shipping"/>
    <bpmn:exclusiveGateway id="eg1" name="Shipping Decision"/>
    <bpmn:task id="t2" name="Special Shipping"/>
    <bpmn:task id="t3" name="Invite Offers"/>
    <bpmn:task id="t4" name="Select Offer"/>
    <bpmn:task id="t5" name="Normal Post"/>
    <bpmn:task id="t6" name="Write Label"/>
    <bpmn:task id="t7" name="Insurance Taken"/>
    <bpmn:task id="t8" name="Packaged Goods"/>
    <bpmn:task id="t9" name="Ready for Pickup"/>
    <bpmn:endEvent id="ee1" name="Pickup Ready"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="eg1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="eg1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t8" targetRef="t9"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t9" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="LogisticsDepartmentHeadProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Offer Invited"/>
    <bpmn:task id="t3_dup2" name="Receive Offers"/>
    <bpmn:task id="t4_dup2" name="Select Offer"/>
    <bpmn:task id="t5_dup2" name="Normal Post"/>
    <bpmn:endEvent id="ee2" name="Offer Selected"/>
    <bpmn:sequenceFlow id="f12" sourceRef="se2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f14" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequence,Flow id="f15" sourceRef="t5" targetRef="ee2"/>
  
    <bpmn:sequenceFlow id="auto_link_out_t5_to_ee2" sourceRef="t5" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="WarehousemenProcess" isExecutable="false">
    <bpmn:startEvent id="se6" name="Packaging Started"/>
    <bpmn:task id="t8_dup2" name="Packaged Goods"/>
    <bpmn:task id="t9_dup2" name="Ready for Pickup"/>
    <bpmn:endEvent id="ee3" name="Pickup Ready"/>
    <bpmn:sequenceFlow id="f16" sourceRef="se6" targetRef="t8"/>
    <bpmn:sequenceFlow id="f17" sourceRef="t8" targetRef="t9"/>
    <bpmn:sequenceFlow id="f18" sourceRef="t9" targetRef="ee3"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram1">
    <bpmndi:BPMNPlane id="BPMNPlane1" bpmnElement="collab1">
      <bpmndi:BPMNShape id="SecretaryProcess_shape" bpmnElement="SecretaryProcess">
        <dc:Bounds x="100" y="100" width="160" height="480"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LogisticsDepartmentHeadProcess_shape" bpmnElement="LogisticsDepartmentHeadProcess">
        <dc:Bounds x="400" y="100" width="160" height="480"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WarehousemenProcess_shape" bpmnElement="WarehousemenProcess">
        <dc:Bounds x="700" y="100" width="160" height="480"/>
      </bpmndi:BPMNShape>
