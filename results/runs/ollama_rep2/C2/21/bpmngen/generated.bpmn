      <bpmndi:BPMNShape id="se6_shape" bpmnElement="se6">
        <dc:Bounds x="780" y="320" width="100" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_shape2" bpmnElement="t8">
        <dc:Bounds x="880" y="320" width="100" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t9_shape2" bpmnElement="t9">
