      <bpmndi:BPMNShape id="se2_shape" bpmnElement="se2">
        <dc:Bounds x="420" y="240" width="100" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_shape2" bpmnElement="t3">
        <dc:Bounds x="540" y="240" width="100" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_shape2" bpmnElement="t4">
        <dc:Bounds x="660" y="240" width="100" height="36"/>
      </bpmndi:BPMNShape>
