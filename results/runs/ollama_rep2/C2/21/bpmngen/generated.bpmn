      <bpmndi:BPMNShape id="t9_shape" bpmnElement="t9">
        <dc:Bounds x="480" y="200" width="100" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee1_shape" bpmnElement="ee1">
        <dc:Bounds x="600" y="200" width="100" height="36"/>
