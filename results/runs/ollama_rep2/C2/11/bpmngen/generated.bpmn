<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="System" processRef="SystemProcess"/>
    <bpmn:participant id="p3" name="Support Team" processRef="SupportTeamProcess"/>
    <bpmn:messageFlow id="mf1" name="Subscription Info" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Account Created" sourceRef="t2" targetRef="ice1"/>
    <bpmn:messageFlow id="mf3" name="Billing Cycle" sourceRef="t3" targetRef="ice2"/>
    <bpmn:messageFlow id="mf4" name="Cancellation Request" sourceRef="t4" targetRef="se3"/>
    <bpmn:messageFlow id="mf5" name="Refund Applied" sourceRef="t5" targetRef="ice3"/>
    <bpmn:messageFlow id="mf6" name="Subscription Deactivated" sourceRef="t6" targetRef="ice4"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Sign Up"/>
    <bpmn:task id="t1" name="Provide Subscription Info"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Account Created">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Billing Cycle">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Refund Applied">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice4" name="Subscription Deactivated">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Subscription Complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="ice2" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="ice3" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f6" sourceRef="ice4" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="SystemProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Subscription Info Received">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:startEvent>
    <bpmn:task id="t2" name="Generate Account"/>
    <bpmn:task id="t3" name="Trigger Billing Cycle"/>
    <bpmn:endEvent id="ee2" name="System Complete"/>
    <bpmn:sequenceFlow id="f7" sourceRef="se2" targetRef="t2"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t3" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="SupportTeamProcess" isExecutable="false">
    <bpmn:startEvent id="se3" name="Cancellation Request Received">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:startEvent>
    <bpmn:task id="t4" name="Process Cancellation Request"/>
    <bpmn:task id="t5" name="Apply Refund"/>
    <bpmn:task id="t6" name="Deactivate Subscription"/>
    <bpmn:endEvent id="ee3" name="Support Complete"/>
    <bpmn:sequenceFlow id="f10" sourceRef="se3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequence
</think>


    <bpmn:sequenceFlow id="auto_link_out_t5_to_t6" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="auto_link_out_t6_to_ee3" sourceRef="t6" targetRef="ee3"/>
  </bpmn:process>
</bpmn:definitions>