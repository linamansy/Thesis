<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="System" processRef="SystemProcess"/>
    <bpmn:participant id="p3" name="Inventory System" processRef="InventorySystemProcess"/>
    <bpmn:participant id="p4" name="Warehouse" processRef="WarehouseProcess"/>
    <bpmn:participant id="p5" name="Quality Control" processRef="QualityControlProcess"/>
    <bpmn:participant id="p6" name="Packaging" processRef="PackagingProcess"/>
    <bpmn:participant id="p7" name="Shipping Department" processRef="ShippingDepartmentProcess"/>
    <bpmn:participant id="p8" name="Returns Department" processRef="ReturnsDepartmentProcess"/>
    <bpmn:messageFlow id="mf1" name="Place Order" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Payment Process" sourceRef="t2" targetRef="se4"/>
    <bpmn:messageFlow id="mf3" name="Payment Failed" sourceRef="ice1" targetRef="t3"/>
    <bpmn:messageFlow id="mf4" name="Payment Successful" sourceRef="ice2" targetRef="se5"/>
    <bpmn:messageFlow id="mf5" name="Stock Check" sourceRef="t4" targetRef="se6"/>
    <bpmn:messageFlow id="mf6" name="Out of Stock" sourceRef="ice3" targetRef="t5"/>
    <bpmn:messageFlow id="mf7" name="In Stock" sourceRef="ice4" targetRef="se7"/>
    <bpmn:messageFlow id="mf8" name="Pick Items" sourceRef="t6" targetRef="se8"/>
    <bpmn:messageFlow id="mf9" name="Quality Check" sourceRef="t7" targetRef="se9"/>
    <bpmn:messageFlow id="mf10" name="Packaging" sourceRef="t8" targetRef="se10"/>
    <bpmn:messageFlow id="mf11" name="Gift Wrap" sourceRef="t9" targetRef="se11"/>
    <bpmn:messageFlow id="mf12" name="Shipping Documents" sourceRef="t10" targetRef="se12"/>
    <bpmn:messageFlow id="mf13" name="Customs Docs" sourceRef="t11" targetRef="se13"/>
    <bpmn:messageFlow id="mf14" name="Dispatch Order" sourceRef="t12" targetRef="se14"/>
    <bpmn:messageFlow id="mf15" name="Shipping Confirmation" sourceRef="ice5" targetRef="t13"/>
    <bpmn:messageFlow id="mf16" name="Inventory Update" sourceRef="ice6" targetRef="t14"/>
    <bpmn:messageFlow id="mf17" name="Feedback Email" sourceRef="ice7" targetRef="t15"/>
    <bpmn:messageFlow id="mf18" name="Return Request" sourceRef="ice8" targetRef="se16"/>
    <bpmn:messageFlow id="mf19" name="Return Label" sourceRef="t16" targetRef="ice9"/>
    <bpmn:messageFlow id="mf20" name="Receive Return" sourceRef="t17" targetRef="ice10"/>
    <bpmn:messageFlow id="mf21" name="Inspect Return" sourceRef="t18" targetRef="ice11"/>
    <bpmn:messageFlow id="mf22" name="Refund/Replace" sourceRef="ice12" targetRef="ice13"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Start"/>
    <bpmn:task id="t1" name="Place Order"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Payment Failed">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Payment Successful">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="End"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="t1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="ice1" targetRef="ee1"/>
    
  
    <bpmn:sequenceFlow id="auto_link_out_ice2_to_ee1" sourceRef="ice2" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="SystemProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Order Received">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:startEvent>
    <bpmn:task id="t2" name="Record Order Details"/>
    <bpmn:task id="t3" name="Process Payment"/>
    <bpmn:intermediateCatchEvent id="ice3" name="Payment Failed">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice4" name="Payment Successful">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f6" sourceRef="se2" targetRef="t2"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t3" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t3" targetRef="ice4"/>
    
    
  </bpmn:process>
  <bpmn:process id="InventorySystemProcess" isExecutable="false">
    <bpmn:startEvent id="se3" name="Payment Successful">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:startEvent>
    <bpmn:task id="t4" name="Check Stock Availability"/>
    <bpmn:intermediateCatchEvent id="ice5" name="Out of Stock">
      <bpmn:messageEventDefinition id="med7"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice6" name="In Stock">
      <bpmn:messageEventDefinition id="med8"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f12" sourceRef="se3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t4" targetRef="ice5"/>
    <bpmn:sequenceFlow id="f14" sourceRef="t4" targetRef="ice6"/>
    
    
  </bpmn:process>
  <bpmn:process id="WarehouseProcess" isExecutable="false">
    <bpmn:startEvent id="se4" name="In Stock">
      <bpmn:messageEventDefinition id="med9"/>
    </bpmn:startEvent>
    <bpmn:task id="t5" name="Pick Items"/>
    <bpmn:intermediateCatchEvent id="ice7" name="Pick Items Complete">
      <bpmn:messageEventDefinition id="med10"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f17" sourceRef="se4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f18" sourceRef="t5" targetRef="ice7"/>
    
  </bpmn:process>
  <bpmn:process id="QualityControlProcess" isExecutable="false">
    <bpmn:startEvent id="se5" name="Pick Items Complete">
      <bpmn:messageEventDefinition id="med11"/>
    </bpmn:startEvent>
    <bpmn:task id="t6" name="Quality Check"/>
    <bpmn:intermediateCatchEvent id="ice8" name="Quality Check Complete">
      <bpmn:messageEventDefinition id="med12"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f20" sourceRef="se5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f21" sourceRef="t6" targetRef="ice8"/>
    <bpmn:sequence
</bpmn:definitions>