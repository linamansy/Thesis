<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="User" processRef="UserProcess"/>
    <bpmn:participant id="p2" name="Online Shop" processRef="OnlineShopProcess"/>
    <bpmn:messageFlow id="mf1" name="Login" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Select Items" sourceRef="t2" targetRef="t3"/>
    <bpmn:messageFlow id="mf3" name="Set Payment Method" sourceRef="t2" targetRef="t4"/>
    <bpmn:messageFlow id="mf4" name="Payment Confirmation" sourceRef="t5" targetRef="ice1"/>
    <bpmn:messageFlow id="mf5" name="Installment Agreement" sourceRef="t6" targetRef="ice2"/>
    <bpmn:messageFlow id="mf6" name="Choose Reward" sourceRef="t7" targetRef="t8"/>
    <bpmn:messageFlow id="mf7" name="Reward Selected" sourceRef="t8" targetRef="t9"/>
    <bpmn:messageFlow id="mf8" name="Order Placed" sourceRef="t10" targetRef="se3"/>
    <bpmn:messageFlow id="mf9" name="Delivery Request" sourceRef="t11" targetRef="ice4"/>
    <bpmn:messageFlow id="mf10" name="Delivery Complete" sourceRef="t12" targetRef="ice5"/>
    <bpmn:messageFlow id="mf11" name="Return Request" sourceRef="t13" targetRef="ice6"/>
    <bpmn:messageFlow id="mf12" name="Return Accepted" sourceRef="ice6" targetRef="se4"/>
    <bpmn:messageFlow id="mf13" name="New Delivery Request" sourceRef="se4" targetRef="t11"/>
  </bpmn:collaboration>
  <bpmn:process id="UserProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Start Process"/>
    <bpmn:task id="t1" name="Login"/>
    <bpmn:parallelGateway id="pg1" name="Simultaneous Actions"/>
    <bpmn:task id="t2" name="Select Items"/>
    <bpmn:task id="t3" name="Set Payment Method"/>
    <bpmn:exclusiveGateway id="eg1" name="Payment or Installment"/>
    <bpmn:task id="t4" name="Pay"/>
    <bpmn:task id="t5" name="Payment Confirmation"/>
    <bpmn:task id="t6" name="Installment Agreement"/>
    <bpmn:task id="t7" name="Choose Reward"/>
    <bpmn:task id="t8" name="Reward Selected"/>
    <bpmn:task id="t9" name="Order Confirmation"/>
    <bpmn:task id="t10" name="Order Placed"/>
    <bpmn:task id="t11" name="Delivery Request"/>
    <bpmn:task id="t12" name="Delivery Complete"/>
    <bpmn:task id="t13" name="Return Request"/>
    <bpmn:endEvent id="ee1" name="End Process"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="pg1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="pg1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="pg1" targetRef="t3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t2" targetRef="t7"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="eg1"/>
    <bpmn:sequenceFlow id="f7" sourceRef="eg1" targetRef="t4"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="t9"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t2" targetRef="t6"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t6" targetRef="t9"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t9" targetRef="t10"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t10" targetRef="t11"/>
    <bpmn:sequenceFlow id="f14" sourceRef="t11" targetRef="t12"/>
    <bpmn:sequenceFlow id="f15" sourceRef="t12" targetRef="ee1"/>
    <bpmn:sequenceFlow id="f16" sourceRef="t12" targetRef="t13"/>
    
    
  
    <bpmn:sequenceFlow id="auto_link_out_t7_to_t8" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="auto_link_out_t8_to_t9" sourceRef="t8" targetRef="t9"/>
    <bpmn:sequenceFlow id="auto_link_out_t13_to_ee1" sourceRef="t13" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="OnlineShopProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Order Received">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="ice1" name="Payment Confirmation">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Installment Agreement">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Return Accepted">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice4" name="Delivery Request">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice5" name="Delivery Complete">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice6" name="Return Request">
      <bpmn:messageEventDefinition id="med7"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee2" name="End Process"/>
    <bpmn:task id="t1_dup2" name="Validate Order"/>
    <bpmn:task id="t2_dup2" name="Process Payment"/>
    <bpmn:task id="t3_dup2" name="Process Installment Agreement"/>
    <bpmn:task id="t4_dup2" name="Process Reward Selection"/>
    <bpmn:task id="t5_dup2" name="Confirm Order"/>
    <bpmn:task id="t6_dup2" name="Send Delivery Confirmation"/>
    <bpmn:task id="t7_dup2" name="Process Return Request"/>
    <bpmn:task id="t8_dup2" name="Send New Delivery Request"/>
    <bpmn:sequenceFlow id="f1_dup2" sourceRef="se2" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2_dup2" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f3_dup2" sourceRef="t2" targetRef="t5"/>
    <bpmn:sequenceFlow id="f4_dup2" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f5_dup2" sourceRef="ice1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f6_dup2" sourceRef="ice2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f7_dup2" sourceRef="t3" targetRef="t5"/>
    <bpmn:sequenceFlow id="f8_dup2" sourceRef="t2" targetRef="t4"/>
    <bpmn:sequenceFlow id="f9_dup2" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f10_dup2" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f11_dup2" sourceRef="t6" targetRef="ee2"/>
    <bpmn:sequenceFlow id="f12_dup2" sourceRef="ice4" targetRef="t6"/>
    <bpmn:sequenceFlow id="f13_dup2" sourceRef="t6" targetRef="ice5"/>
    <bpmn:sequenceFlow id="f14_dup2" sourceRef="ice5" targetRef="ee2"/>
    <bpmn:sequenceFlow id="f15_dup2" sourceRef="ice6" targetRef="t7"/>
    <bpmn:sequenceFlow id="f16_dup2" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="f17" sourceRef="t8" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f18" sourceRef="ice3" targetRef="t6"/>
  
    <bpmn:sequenceFlow id="auto_link_in_se2_to_ice1" sourceRef="se2" targetRef="ice1"/>
    <bpmn:sequenceFlow id="auto_link_in_ice1_to_ice2" sourceRef="ice1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="auto_link_in_ice3_to_ice4" sourceRef="ice3" targetRef="ice4"/>
    <bpmn:sequenceFlow id="auto_link_in_ice5_to_ice6" sourceRef="ice5" targetRef="ice6"/>
    <bpmn:sequenceFlow id="auto_link_out_ee2_to_t1" sourceRef="ee2" targetRef="t1"/>
  </bpmn:process>
</bpmn:definitions>