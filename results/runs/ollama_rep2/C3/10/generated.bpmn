<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Employee/Department" processRef="EmployeeProcess"/>
    <bpmn:participant id="p2" name="IT Department" processRef="ITProcess"/>
    <bpmn:messageFlow id="mf1" name="Submit Request" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Request Approved" sourceRef="ice1" targetRef="t3"/>
    <bpmn:messageFlow id="mf3" name="Solution Ready" sourceRef="ice1" targetRef="t5"/>
    <bpmn:messageFlow id="mf4" name="Solution Deployed" sourceRef="t6" targetRef="ee3"/>
  </bpmn:collaboration>
  <bpmn:process id="EmployeeProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Start"/>
    <bpmn:task id="t1" name="Submit Request"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Request Approved">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="End"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="ITProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Request Received">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:startEvent>
    <bpmn:task id="t2" name="Assess Request"/>
    <bpmn:exclusiveGateway id="g1" name="Is Approved?"/>
    <bpmn:task id="t3" name="Procure Tools"/>
    <bpmn:task id="t4" name="Install Solution"/>
    <bpmn:task id="t5" name="Deploy Solution"/>
    <bpmn:task id="t6" name="Provide Training"/>
    <bpmn:endEvent id="ee2" name="End"/>
    <bpmn:sequenceFlow id="f4" sourceRef="se2" targetRef="t2"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t2" targetRef="g1"/>
    <bpmn:sequenceFlow id="f6" sourceRef="g1" targetRef="t3"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="ee2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram1">
    <bpmndi:BPMNPlane id="BPMNPlane1" bpmnElement="collab1">
      <bpmndi:BPMNShape id="EmployeeProcess_1" bpmnElement="se1">
        <dc:Bounds x="100" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EmployeeProcess_2" bpmnElement="t1">
        <dc:Bounds x="200" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EmployeeProcess_3" bpmnElement="ice1">
        <dc:Bounds x="300" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EmployeeProcess_4" bpmnElement="ee1">
        <dc:Bounds x="400" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_1" bpmnElement="se2">
        <dc:Bounds x="100" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_2" bpmnElement="t2">
        <dc:Bounds x="200" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_3" bpmnElement="g1">
        <dc:Bounds x="300" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_4" bpmnElement="t3">
        <dc:Bounds x="400" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_5" bpmnElement="t4">
        <dc:Bounds x="500" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_6" bpmnElement="t5">
        <dc:Bounds x="600" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_7" bpmnElement="t6">
        <dc:Bounds x="700" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_8" bpmnElement="ee2">
        <dc:Bounds x="800" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_dup2" bpmnElement="EmployeeProcess">
        <dc:Bounds x="0" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_dup2" bpmnElement="ITProcess">
        <dc:Bounds x="0" y="300" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_dup2" sourceRef="se1" targetRef="t1">
        <di:waypoint x="150" y="140"/>
        <di:waypoint x="250" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_dup2" sourceRef="t1" targetRef="ice1">
        <di:waypoint x="250" y="140"/>
        <di:waypoint x="350" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_dup2" sourceRef="ice1" targetRef="ee1">
        <di:waypoint x="350" y="140"/>
        <di:waypoint x="450" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_dup2" sourceRef="se2" targetRef="t2">
        <di:waypoint x="150" y="240"/>
        <di:waypoint x="250" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_dup2" sourceRef="t2" targetRef="g1">
        <di:waypoint x="250" y="240"/>
        <di:waypoint x="350" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_dup2" sourceRef="g1" targetRef="t3">
        <di:waypoint x="350" y="240"/>
        <di:waypoint x="450" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_dup2" sourceRef="t3" targetRef="t4">
        <di:waypoint x="450" y="240"/>
        <di:waypoint x="550" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_dup2" sourceRef="t4" targetRef="t5">
        <di:waypoint x="550" y="240"/>
        <di:waypoint x="650" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_dup2" sourceRef="t5" targetRef="t6">
        <di:waypoint x="650" y="240"/>
        <di:waypoint x="750" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_dup2" sourceRef="t6" targetRef="ee2">
        <di:waypoint x="750" y="240"/>
        <di:waypoint x="850" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf1_dup2" sourceRef="t1" targetRef="se2">
        <di:waypoint x="250" y="140"/>
        <di:waypoint x="150" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf2_dup2" sourceRef="ice1" targetRef="t3">
        <di:waypoint x="350" y="140"/>
        <di:waypoint x="450" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf3_dup2" sourceRef="ee1" targetRef="t5">
        <di:waypoint x="450" y="140"/>
        <di:waypoint x="650" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf4_dup2" sourceRef="ee2" targetRef="ee1">
        <di:waypoint x="850" y="240"/>
        <di:waypoint x="450" y="140"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>