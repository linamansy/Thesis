      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ProcurementProcess_f7" bpmnElement="f7">
        <di:waypoint x="950" y="140"/>
        <di:waypoint x="1000" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ProcurementProcess_f8" bpmnElement="f8">
        <di:waypoint x="1050" y="140"/>
        <di:waypoint x="1100" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ProcurementProcess_f9" bpmnElement="f9">
        <di:waypoint x="1150" y="140"/>
        <di:waypoint x="1200" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SuppliersProcess_f10" bpmnElement="f10">
        <di:waypoint x="150" y="260"/>
        <di:waypoint x="200" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SuppliersProcess_f11" bpmnElement="f11">
        <di:waypoint x="300" y="260"/>
        <di:waypoint x="350" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SuppliersProcess_f12" bpmnElement="f12">
        <di:waypoint x="450" y="260"/>
        <di:waypoint x="500" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SuppliersProcess_f13" bpmnElement="f13">
        <di:waypoint x="600" y="260"/>
        <di:waypoint x="650" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SuppliersProcess_f14" bpmnElement="f14">
        <di:waypoint x="750" y="260"/>
        <di:waypoint x="800" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="collab1-mf1" bpmnElement="mf1">
        <di:waypoint x="1450" y="100"/>
        <di:waypoint x="1500" y="100"/>
        <di:waypoint x="1500" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="collab1-mf2" bpmnElement="mf2">
        <di:waypoint x="1450" y="100"/>
        <di:waypoint x="1500" y="100"/>
        <di:waypoint x="1500" y="260"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>