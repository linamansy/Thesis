<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Secretary" processRef="SecretaryProcess"/>
    <bpmn:participant id="p2" name="Logistics Department Head" processRef="LogisticsDepartmentHeadProcess"/>
    <bpmn:participant id="p3" name="Warehousemen" processRef="WarehousemenProcess"/>
    <bpmn:messageFlow id="mf1" name="Shipping Decision" sourceRef="t1" targetRef="t2"/>
    <bpmn:messageFlow id="mf2" name="Special Shipping Request" sourceRef="t3" targetRef="t4"/>
    <bpmn:messageFlow id="mf3" name="Offer Invitations" sourceRef="t5" targetRef="t6"/>
    <bpmn:messageFlow id="mf4" name="Offer Selection" sourceRef="t7" targetRef="t8"/>
    <bpmn:messageFlow id="mf5" name="Normal Post Shipment" sourceRef="t9" targetRef="t10"/>
    <bpmn:messageFlow id="mf6" name="Package Label" sourceRef="t11" targetRef="t12"/>
    <bpmn:messageFlow id="mf7" name="Parcel Insurance" sourceRef="t13" targetRef="t14"/>
    <bpmn:messageFlow id="mf8" name="Packaged Goods Ready" sourceRef="t15" targetRef="t16"/>
  </bpmn:collaboration>
  <bpmn:process id="SecretaryProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Goods Shall Be Shipped"/>
    <bpmn:task id="t1" name="Clarify Who Will Do the Shipping"/>
    <bpmn:exclusiveGateway id="g1" name="Shipping Decision"/>
    <bpmn:task id="t2" name="Special Shipping Request"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="g1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="g1" targetRef="t2"/>
    
  </bpmn:process>
  <bpmn:process id="LogisticsDepartmentHeadProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Special Shipping Request"/>
    <bpmn:task id="t3" name="Invite Three Logistic Companies to Make Offers"/>
    <bpmn:task id="t4" name="Select One Logistic Company"/>
    <bpmn:sequenceFlow id="f5" sourceRef="se2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="t4"/>
    
  </bpmn:process>
  <bpmn:process id="WarehousemenProcess" isExecutable="false">
    <bpmn:startEvent id="se3" name="Normal Post Shipment"/>
    <bpmn:task id="t5" name="Package Goods"/>
    <bpmn:task id="t6" name="Write Package Label"/>
    <bpmn:task id="t7" name="Take Parcel Insurance"/>
    <bpmn:task id="t8" name="Prepare Packaged Goods for Pickup"/>
    <bpmn:sequenceFlow id="f8" sourceRef="se3" targetRef="t5"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t7" targetRef="t8"/>
    
  </bpmn:process>
  <bpmn:process id="SecretaryProcess_dup2" isExecutable="false">
    <bpmn:task id="t9" name="Normal Post Shipment"/>
    <bpmn:task id="t10" name="Write Package Label"/>
    <bpmn:task id="t11" name="Take Parcel Insurance"/>
    <bpmn:task id="t12" name="Prepare Packaged Goods for Pickup"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t9" targetRef="t10"/>
    <bpmn:sequenceFlow id="f14" sourceRef="t10" targetRef="t11"/>
    <bpmn:sequenceFlow id="f15" sourceRef="t11" targetRef="t12"/>
    
  </bpmn:process>
  <bpmn:process id="LogisticsDepartmentHeadProcess_dup2" isExecutable="false">
    <bpmn:task id="t13" name="Take Parcel Insurance"/>
    <bpmn:task id="t14" name="Prepare Packaged Goods for Pickup"/>
    <bpmn:sequenceFlow id="f17" sourceRef="t13" targetRef="t14"/>
    
  </bpmn:process>
  <bpmn:process id="WarehousemenProcess_dup2" isExecutable="false">
    <bpmn:task id="t15" name="Prepare Packaged Goods for Pickup"/>
    
  </bpmn:process>
  <bpmn:process id="SecretaryProcess_dup3" isExecutable="false">
    <bpmn:endEvent id="ee1" name="End"/>
    
  </bpmn:process>
