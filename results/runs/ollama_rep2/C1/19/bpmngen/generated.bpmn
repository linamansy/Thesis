<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="User" processRef="UserProcess"/>
    <bpmn:participant id="p2" name="Online Shop" processRef="OnlineShopProcess"/>
    <bpmn:messageFlow id="mf1" name="Login" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Select Items" sourceRef="t2" targetRef="se4"/>
    <bpmn:messageFlow id="mf3" name="Set Payment Method" sourceRef="t3" targetRef="se4"/>
    <bpmn:messageFlow id="mf4" name="Payment" sourceRef="t4" targetRef="se6"/>
    <bpmn:messageFlow id="mf5" name="Installment Agreement" sourceRef="t5" targetRef="se6"/>
    <bpmn:messageFlow id="mf6" name="Choose Reward" sourceRef="t6" targetRef="se8"/>
    <bpmn:messageFlow id="mf7" name="Reward Selected" sourceRef="t7" targetRef="se8"/>
    <bpmn:messageFlow id="mf8" name="Order Confirmed" sourceRef="t8" targetRef="se10"/>
    <bpmn:messageFlow id="mf9" name="Delivery" sourceRef="t9" targetRef="se12"/>
    <bpmn:messageFlow id="mf10" name="Return Request" sourceRef="t10" targetRef="se14"/>
    <bpmn:messageFlow id="mf11" name="Return Accepted" sourceRef="t11" targetRef="se14"/>
    <bpmn:messageFlow id="mf12" name="New Delivery" sourceRef="t12" targetRef="se16"/>
  </bpmn:collaboration>
  <bpmn:process id="UserProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Start Process"/>
    <bpmn:task id="t1" name="Login"/>
    <bpmn:parallelGateway id="pg1" name="Parallel Gateway"/>
    <bpmn:task id="t2" name="Select Items"/>
    <bpmn:task id="t3" name="Set Payment Method"/>
    <bpmn:exclusiveGateway id="eg1" name="Payment or Installment"/>
    <bpmn:task id="t4" name="Payment"/>
    <bpmn:task id="t5" name="Installment Agreement"/>
    <bpmn:task id="t6" name="Choose Reward"/>
    <bpmn:task id="t7" name="Reward Selected"/>
    <bpmn:task id="t8" name="Order Confirmed"/>
    <bpmn:task id="t9" name="Delivery"/>
    <bpmn:task id="t10" name="Return Request"/>
    <bpmn:task id="t11" name="Return Accepted"/>
    <bpmn:task id="t12" name="New Delivery"/>
    <bpmn:endEvent id="ee1" name="End Process"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="pg1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="pg1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="pg1" targetRef="t3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="eg1"/>
    <bpmn:sequenceFlow id="f7" sourceRef="eg1" targetRef="t4"/>
    <bpmn:sequenceFlow id="f8" sourceRef="eg1" targetRef="t5"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t4" targetRef="t6"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t8" targetRef="t9"/>
    <bpmn:sequenceFlow id="f14" sourceRef="t9" targetRef="t10"/>
    <bpmn:sequenceFlow id="f15" sourceRef="t10" targetRef="t11"/>
    <bpmn:sequenceFlow id="f16" sourceRef="t11" targetRef="t12"/>
    <bpmn:sequenceFlow id="f17" sourceRef="t12" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="OnlineShopProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Login Received">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="ice1" name="Select Items">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Set Payment Method">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Payment Received">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice4" name="Installment Agreement Received">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice5" name="Reward Selected">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice6" name="Order Confirmed">
      <bpmn:messageEventDefinition id="med7"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice7" name="Delivery Request">
      <bpmn:messageEventDefinition id="med8"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice8" name="Return Request">
      <bpmn:messageEventDefinition id="med9"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice9" name="Return Accepted">
      <bpmn:messageEventDefinition id="med10"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee2" name="End Process"/>
    <bpmn:sequenceFlow id="f1_dup2" sourceRef="se2" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f2_dup2" sourceRef="ice1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f3_dup2" sourceRef="ice2" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f4_dup2" sourceRef="ice3" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f5_dup2" sourceRef="ice4" targetRef="ice5"/>
    <bpmn:sequence
</think>


    <bpmn:sequenceFlow id="auto_link_out_ice5_to_ice6" sourceRef="ice5" targetRef="ice6"/>
    <bpmn:sequenceFlow id="auto_link_out_ice6_to_ice7" sourceRef="ice6" targetRef="ice7"/>
    <bpmn:sequenceFlow id="auto_link_out_ice7_to_ice8" sourceRef="ice7" targetRef="ice8"/>
    <bpmn:sequenceFlow id="auto_link_out_ice8_to_ice9" sourceRef="ice8" targetRef="ice9"/>
    <bpmn:sequenceFlow id="auto_link_out_ice9_to_ee2" sourceRef="ice9" targetRef="ee2"/>
  </bpmn:process>
</bpmn:definitions>