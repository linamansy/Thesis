<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="Sales Staff" processRef="SalesProcess"/>
    <bpmn:messageFlow id="mf1" name="Inquiry" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Customer Info" sourceRef="t2" targetRef="ice1"/>
    <bpmn:messageFlow id="mf3" name="Quote" sourceRef="t3" targetRef="ice2"/>
    <bpmn:messageFlow id="mf4" name="Order Confirmation" sourceRef="t5" targetRef="ee1"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Inquiry"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Customer Info Received">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Quote Approved">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Order Confirmed">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Order Complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="ice1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice2" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f4" sourceRef="ice3" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="SalesProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Inquiry Received">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Collect Customer Info"/>
    <bpmn:task id="t2" name="Provide Quote"/>
    <bpmn:task id="t3" name="Place Order"/>
    <bpmn:endEvent id="ee1_dup2" name="Order Confirmed"/>
    <bpmn:sequenceFlow id="f1_dup2" sourceRef="se2" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2_dup2" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f3_dup2" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f4_dup2" sourceRef="t3" targetRef="ee1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram1">
    <bpmndi:BPMNPlane id="BPMNPlane1" bpmnElement="collab1">
      <bpmndi:BPMNShape id="CustomerProcess_dup2" bpmnElement="CustomerProcess">
        <dc:Bounds x="200" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SalesProcess_dup2" bpmnElement="SalesProcess">
        <dc:Bounds x="400" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se1_dup2" bpmnElement="se1">
        <dc:Bounds x="100" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice1_dup2" bpmnElement="ice1">
        <dc:Bounds x="100" y="180" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice2_dup2" bpmnElement="ice2">
        <dc:Bounds x="100" y="260" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice3_dup2" bpmnElement="ice3">
        <dc:Bounds x="100" y="340" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee1_dup3" bpmnElement="ee1">
        <dc:Bounds x="100" y="420" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se2_dup2" bpmnElement="se2">
        <dc:Bounds x="400" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_dup2" bpmnElement="t1">
        <dc:Bounds x="400" y="140" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_dup2" bpmnElement="t2">
        <dc:Bounds x="400" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_dup2" bpmnElement="t3">
        <dc:Bounds x="400" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee1_1" bpmnElement="ee1">
        <dc:Bounds x="400" y="380" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_dup3" sourceRef="se1" targetRef="ice1">
        <di:waypoint x="136" y="100"/>
        <di:waypoint x="100" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_dup3" sourceRef="ice1" targetRef="ice2">
        <di:waypoint x="136" y="180"/>
        <di:waypoint x="100" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_dup3" sourceRef="ice2" targetRef="ice3">
        <di:waypoint x="136" y="260"/>
        <di:waypoint x="100" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_dup3" sourceRef="ice3" targetRef="ee1">
        <di:waypoint x="136" y="340"/>
        <di:waypoint x="100" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f1_1" sourceRef="se2" targetRef="t1">
        <di:waypoint x="436" y="100"/>
        <di:waypoint x="400" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_1" sourceRef="t1" targetRef="t2">
        <di:waypoint x="450" y="140"/>
        <di:waypoint x="400" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_1" sourceRef="t2" targetRef="t3">
        <di:waypoint x="450" y="220"/>
        <di:waypoint x="400" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_1" sourceRef="t3" targetRef="ee1_1">
        <di:waypoint x="450" y="300"/>
        <di:waypoint x="400" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf1_dup2" sourceRef="t1" targetRef="se2">
        <di:waypoint x="450" y="140"/>
        <di:waypoint x="436" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf2_dup2" sourceRef="t2" targetRef="ice1">
        <di:waypoint x="450" y="220"/>
        <di:waypoint x="136" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf3_dup2" sourceRef="t3" targetRef="ice2">
        <di:waypoint x="450" y="300"/>
        <di:waypoint x="136" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf4_dup2" sourceRef="ice3" targetRef="ee1">
        <di:waypoint x="136" y="340"/>
        <di:waypoint x="100" y="420"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>