<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="System" processRef="SystemProcess"/>
    <bpmn:messageFlow id="mf1" name="Login Confirmation" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Product Selected" sourceRef="t3" targetRef="ice1"/>
    <bpmn:messageFlow id="mf3" name="Product Added" sourceRef="t5" targetRef="ice2"/>
    <bpmn:messageFlow id="mf4" name="Payment Data" sourceRef="t7" targetRef="se6"/>
    <bpmn:messageFlow id="mf5" name="Payment Confirmed" sourceRef="ice4" targetRef="se8"/>
    <bpmn:messageFlow id="mf6" name="Shipping Address" sourceRef="t9" targetRef="ice5"/>
    <bpmn:messageFlow id="mf7" name="Order Finished" sourceRef="ice5" targetRef="ee2"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Log In"/>
    <bpmn:task id="t1" name="Login"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Login Confirmed">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g1" name="Select Product"/>
    <bpmn:task id="t3" name="Select Product"/>
    <bpmn:task id="t4" name="Add to Cart"/>
    <bpmn:intermediateCatchEvent id="ice2" name="Product Already Selected">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g2" name="All Products Selected"/>
    <bpmn:task id="t5" name="Save Product"/>
    <bpmn:task id="t6" name="Check Selection"/>
    <bpmn:intermediateCatchEvent id="ice3" name="All Products Selected">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t7" name="Enter Payment Data"/>
    <bpmn:intermediateCatchEvent id="ice4" name="Payment Confirmed">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t8" name="Enter Shipping Address"/>
    <bpmn:intermediateCatchEvent id="ice5" name="Shipping Address Entered">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Order Finished"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="g1"/>
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="t3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t4" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f7" sourceRef="ice2" targetRef="t5"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t6" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f10" sourceRef="ice3" targetRef="t7"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t7" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f12" sourceRef="ice4" targetRef="t8"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t8" targetRef="ice5"/>
    <bpmn:sequenceFlow id="f14" sourceRef="ice5" targetRef="ee1"/>
  
    <bpmn:sequenceFlow id="auto_link_in_g1_to_g2" sourceRef="g1" targetRef="g2"/>
    <bpmn:sequenceFlow id="auto_link_out_g2_to_t7" sourceRef="g2" targetRef="t7"/>
  </bpmn:process>
  <bpmn:process id="SystemProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Check Login">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:startEvent>
    <bpmn:task id="t2" name="Validate Login"/>
    <bpmn:endEvent id="ee2" name="Login Confirmed"/>
    <bpmn:sequenceFlow id="f15" sourceRef="se2" targetRef="t2"/>
    <bpmn:sequenceFlow id="f16" sourceRef="t2" targetRef="ee2"/>
    <bpmn:intermediateCatchEvent id="ice6" name="Order Finished">
      <bpmn:messageEventDefinition id="med7"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee3" name="Order Completed"/>
    <bpmn:sequenceFlow id="f17" sourceRef="ice6" targetRef="ee3"/>
  </bpmn:process>
</bpmn:definitions>