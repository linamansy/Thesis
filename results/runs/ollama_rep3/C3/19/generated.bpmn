    <bpmn:sequenceFlow id="f8" sourceRef="eg1" targetRef="t5"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t8" targetRef="ee1"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t8" targetRef="t9"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t9" targetRef="t10"/>
    
    
  
    <bpmn:sequenceFlow id="auto_link_out_t4_to_t5" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="auto_link_out_t5_to_t6" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="auto_link_out_t10_to_ee1" sourceRef="t10" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="OnlineShopProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Order Received">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:startEvent>
    <bpmn:task id="t1_dup2" name="Validate Login"/>
    <bpmn:task id="t2_dup2" name="Process Items"/>
    <bpmn:task id="t3_dup2" name="Process Payment"/>
    <bpmn:task id="t4_dup2" name="Process Installment"/>
    <bpmn:task id="t5_dup2" name="Process Reward"/>
    <bpmn:task id="t6_dup2" name="Prepare Delivery"/>
    <bpmn:task id="t7_dup2" name="Handle Return"/>
    <bpmn:endEvent id="ee2" name="Delivery Complete"/>
    <bpmn:sequenceFlow id="f1_dup2" sourceRef="se2" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2_dup2" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f3_dup2" sourceRef="t2" targetRef="t3"/>
    
    <bpmn:sequenceFlow id="f5_dup2" sourceRef="t2" targetRef="t4"/>
    
    <bpmn:sequenceFlow id="f7_dup2" sourceRef="t2" targetRef="t5"/>
    
    <bpmn:sequenceFlow id="f9_dup2" sourceRef="t2" targetRef="t6"/>
    
    
    
    
  
    <bpmn:sequenceFlow id="auto_link_out_t3_to_t4" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="auto_link_out_t4_to_t5_dup2" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="auto_link_out_t5_to_t6_dup2" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="auto_link_out_t6_to_t7" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="auto_link_out_t7_to_ee2" sourceRef="t7" targetRef="ee2"/>
  </bpmn:process>
