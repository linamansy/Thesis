<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Contractor" processRef="ContractorProcess"/>
    <bpmn:participant id="p2" name="Web Shop 1" processRef="WebShop1Process"/>
    <bpmn:participant id="p3" name="Web Shop 2" processRef="WebShop2Process"/>
    <bpmn:participant id="p4" name="Web Shop 3" processRef="WebShop3Process"/>
    <bpmn:messageFlow id="mf1" name="Query Shops" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Shop Response" sourceRef="t2" targetRef="ice1"/>
    <bpmn:messageFlow id="mf3" name="Order Parts" sourceRef="t3" targetRef="se4"/>
    <bpmn:messageFlow id="mf4" name="Order Confirmation" sourceRef="t4" targetRef="ice2"/>
    <bpmn:messageFlow id="mf5" name="Parts Arrive" sourceRef="t5" targetRef="ice3"/>
    <bpmn:messageFlow id="mf6" name="Reorder Parts" sourceRef="t6" targetRef="se7"/>
    <bpmn:messageFlow id="mf7" name="Reorder Confirmation" sourceRef="t7" targetRef="ice4"/>
    <bpmn:messageFlow id="mf8" name="Stock Below 5" sourceRef="t8" targetRef="se9"/>
    <bpmn:messageFlow id="mf9" name="Stock Below 3" sourceRef="t9" targetRef="se10"/>
    <bpmn:messageFlow id="mf10" name="Email Complaint" sourceRef="t10" targetRef="ee11"/>
  </bpmn:collaboration>
  <bpmn:process id="ContractorProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Start Contract"/>
    <bpmn:task id="t1" name="Query All Web Shops"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Receive Shop Responses">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t2" name="Select Cheapest Parts"/>
    <bpmn:task id="t3" name="Create Order List"/>
    <bpmn:intermediateCatchEvent id="ice2" name="Order Confirmation">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t4" name="Track Parts Arrival"/>
    <bpmn:intermediateCatchEvent id="ice3" name="Parts Arrived">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t5" name="Start Building"/>
    <bpmn:task id="t6" name="Check Stock Levels"/>
    <bpmn:intermediateCatchEvent id="ice4" name="Stock Below 5">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t7" name="Reorder Parts"/>
    <bpmn:intermediateCatchEvent id="ice5" name="Stock Below 3">
      <bpmn:messageEventningEventDefinition id="med5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t8" name="Reorder Again"/>
    <bpmn:intermediateCatchEvent id="ice6" name="Stock is Zero">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t9" name="Email Webshops"/>
    <bpmn:endEvent id="ee10" name="Contract Complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t3" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f6" sourceRef="ice2" targetRef="t4"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t6" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f10" sourceRef="ice4" targetRef="t7"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t7" targetRef="ice5"/>
    <bpmn:sequenceFlow id="f12" sourceRef="ice5" targetRef="t8"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t8" targetRef="ice6"/>
    <bpmn:sequenceFlow id="f14" sourceRef="ice6" targetRef="t9"/>
    <bpmn:sequenceFlow id="f15" sourceRef="t9" targetRef="ee10"/>
  </bpmn:process>
  <bpmn:process id="WebShop1Process" isExecutable="false">
    <bpmn:startEvent id="se2" name="Shop Query"/>
    <bpmn:task id="t2_dup2" name="Provide Inventory"/>
    <bpmn:endEvent id="ee2" name="Shop Response"/>
    <bpmn:sequenceFlow id="f2_dup2" sourceRef="se2" targetRef="t2"/>
    <bpmn:sequenceFlow id="f3_dup2" sourceRef="t2" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="WebShop2Process" isExecutable="false">
    <bpmn:startEvent id="se3" name="Shop Query"/>
    <bpmn:task id="t3_dup2" name="Provide Inventory"/>
    <bpmn:endEvent id="ee3" name="Shop Response"/>
    <bpmn:sequenceFlow id="f4_dup2" sourceRef="se3" targetRef="t3"/>
    <bpmn:sequenceFlow id="f5_dup2" sourceRef="t3" targetRef="ee3"/>
  </bpmn:process>
  <bpmn:process id="WebShop3Process" isExecutable="false">
    <bpmn:startEvent id="se4" name="Shop Query"/>
    <bpmn:task id="t4_dup2" name="Provide Inventory"/>
    <bpmn:endEvent id="ee4" name="Shop Response"/>
    <bpmn:sequenceFlow id="f6_dup2" sourceRef="se4" targetRef="t4"/>
    <bpmn:sequenceFlow id="f7_dup2" sourceRef="t4" targetRef="ee4"/>
  </bpmn:process>
</bpmn:definitions>