<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Contractor" processRef="ContractorProcess"/>
    <bpmn:participant id="p2" name="Web Shop 1" processRef="WebShop1Process"/>
    <bpmn:participant id="p3" name="Web Shop 2" processRef="WebShop2Process"/>
    <bpmn:participant id="p4" name="Web Shop 3" processRef="WebShop3Process"/>
    <bpmn:messageFlow id="mf1" name="Query Shops" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Query Shops" sourceRef="t1" targetRef="se3"/>
    <bpmn:messageFlow id="mf3" name="Query Shops" sourceRef="t1" targetRef="se4"/>
    <bpmn:messageFlow id="mf4" name="Shop Response 1" sourceRef="t2" targetRef="ice1"/>
    <bpmn:messageFlow id="mf5" name="Shop Response 2" sourceRef="t2" targetRef="ice2"/>
    <bpmn:messageFlow id="mf6" name="Shop Response 3" sourceRef="t2" targetRef="ice3"/>
    <bpmn:messageFlow id="mf7" name="Order Parts" sourceRef="t5" targetRef="se5"/>
    <bpmn:messageFlow id="mf8" name="Order Parts" sourceRef="t5" targetRef="se6"/>
    <bpmn:messageFlow id="mf9" name="Order Parts" sourceRef="t5" targetRef="se7"/>
    <bpmn:messageFlow id="mf10" name="Parts Arrived" sourceRef="t8" targetRef="ice4"/>
    <bpmn:messageFlow id="mf11" name="Parts Arrived" sourceRef="t8" targetRef="ice5"/>
    <bpmn:messageFlow id="mf12" name="Parts Arrived" sourceRef="t8" targetRef="ice6"/>
    <bpmn:messageFlow id="mf13" name="Stock Check" sourceRef="t10" targetRef="ice7"/>
    <bpmn:messageFlow id="mf14" name="Stock Check" sourceRef="t10" targetRef="ice8"/>
    <bpmn:messageFlow id="mf15" name="Stock Check" sourceRef="t10" targetRef="ice9"/>
    <bpmn:messageFlow id="mf16" name="Reorder" sourceRef="t11" targetRef="se10"/>
    <bpmn:messageFlow id="mf17" name="Reorder" sourceRef="t11" targetRef="se11"/>
    <bpmn:messageFlow id="mf18" name="Reorder" sourceRef="t11" targetRef="se12"/>
    <bpmn:messageFlow id="mf19" name="Complain" sourceRef="t13" targetRef="ee1"/>
  </bpmn:collaboration>
  <bpmn:process id="ContractorProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Start Contract"/>
    <bpmn:task id="t1" name="Query All Shops"/>
    <bpmn:exclusiveGateway id="g1" name="Select Cheapest Parts"/>
    <bpmn:task id="t5" name="Order Parts"/>
    <bpmn:intermediateCatchEvent id="ice4" name="Parts Arrived">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice5" name="Parts Arrived">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice6" name="Parts Arrived">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t8" name="Track Parts Arrival"/>
    <bpmn:exclusiveGateway id="g2" name="Check Stock Level"/>
    <bpmn:task id="t10" name="Check Stock Level"/>
    <bpmn:exclusiveGateway id="g3" name="Reorder Decision"/>
    <bpmn:task id="t11" name="Reorder Parts"/>
    <bpmn:intermediateCatchEvent id="ice7" name="Stock Below 5">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice8" name="Stock Below 3">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice9" name="Stock Below 0">
      <bpmn:messageEvent
</think>


    <bpmn:sequenceFlow id="auto_flow_1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="auto_flow_2" sourceRef="t1" targetRef="g1"/>
    <bpmn:sequenceFlow id="auto_flow_3" sourceRef="g1" targetRef="t5"/>
    <bpmn:sequenceFlow id="auto_flow_4" sourceRef="t5" targetRef="ice4"/>
    <bpmn:sequenceFlow id="auto_flow_5" sourceRef="ice4" targetRef="ice5"/>
    <bpmn:sequenceFlow id="auto_flow_6" sourceRef="ice5" targetRef="ice6"/>
    <bpmn:sequenceFlow id="auto_flow_7" sourceRef="ice6" targetRef="t8"/>
    <bpmn:sequenceFlow id="auto_flow_8" sourceRef="t8" targetRef="g2"/>
    <bpmn:sequenceFlow id="auto_flow_9" sourceRef="g2" targetRef="t10"/>
    <bpmn:sequenceFlow id="auto_flow_10" sourceRef="t10" targetRef="g3"/>
    <bpmn:sequenceFlow id="auto_flow_11" sourceRef="g3" targetRef="t11"/>
    <bpmn:sequenceFlow id="auto_flow_12" sourceRef="t11" targetRef="ice7"/>
    <bpmn:sequenceFlow id="auto_flow_13" sourceRef="ice7" targetRef="ice8"/>
    <bpmn:sequenceFlow id="auto_flow_14" sourceRef="ice8" targetRef="ice9"/>
  </bpmn:process>
  <bpmn:process id="WebShop1Process" isExecutable="false">
    <bpmn:startEvent id="se2" name="Receive Query"/>
    <bpmn:task id="t2" name="Provide Parts Info"/>
    <bpmn:endEvent id="ee2" name="End"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se2" targetRef="t2"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t2" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="WebShop2Process" isExecutable="false">
    <bpmn:startEvent id="se3" name="Receive Query"/>
    <bpmn:task id="t3" name="Provide Parts Info"/>
    <bpmn:endEvent id="ee3" name="End"/>
    <bpmn:sequenceFlow id="f3" sourceRef="se3" targetRef="t3"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="ee3"/>
  </bpmn:process>
  <bpmn:process id="WebShop3Process" isExecutable="false">
    <bpmn:startEvent id="se4" name="Receive Query"/>
    <bpmn:task id="t4" name="Provide Parts Info"/>
    <bpmn:endEvent id="ee4" name="End"/>
    <bpmn:sequenceFlow id="f5" sourceRef="se4" targetRef="t4"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t4" targetRef="ee4"/>
  </bpmn:process>
  <bpmn:process id="WebShop1Process_dup2" isExecutable="false">
    <bpmn:startEvent id="se5" name="Receive Order"/>
    <bpmn:task id="t6" name="Ship Parts"/>
    <bpmn:endEvent id="ee5" name="End"/>
    <bpmn:sequenceFlow id="f7" sourceRef="se5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t6" targetRef="ee5"/>
  </bpmn:process>
  <bpmn:process id="WebShop2Process_dup2" isExecutable="false">
    <bpmn:startEvent id="se6" name="Receive Order"/>
    <bpmn:task id="t7" name="Ship Parts"/>
    <bpmn:endEvent id="ee6" name="End"/>
    <bpmn:sequenceFlow id="f9" sourceRef="se6" targetRef="t7"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t7" targetRef="ee6"/>
  </bpmn:process>
  <bpmn:process id="WebShop3Process_dup2" isExecutable="false">
    <bpmn:startEvent id="se7" name="Receive Order"/>
    <bpmn:task id="t8_dup2" name="Ship Parts"/>
    <bpmn:endEvent id="ee7" name="End"/>
    <bpmn:sequenceFlow id="f11" sourceRef="se7" targetRef="t8"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t8" targetRef="ee7"/>
  </bpmn:process>
  <bpmn:process id="ContractorProcess_dup2" isExecutable="false">
    <bpmn:startEvent id="se8" name="Parts Arrived"/>
    <bpmn:task id="t9" name="Update Stock"/>
    <bpmn:exclusiveGateway id="g4" name="Stock Check"/>
    <bpmn:intermediateCatchEvent id="ice10" name="Stock Below 5">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice11" name="Stock Below 3">
      <bpmn:messageEventDefinition id="med7"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice12" name="Stock Below 0">
      <bpmn:messageEventDefinition id="med8"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t12" name="Reorder Parts"/>
    <bpmn:task id="t13" name="Complain to Friends"/>
    <bpmn:endEvent id="ee8" name="End"/>
    <bpmn:sequenceFlow id="f13" sourceRef="se8" targetRef="t9"/>
    <bpmn:sequenceFlow id="f14" sourceRef="t9" targetRef="g4"/>
    <bpmn:sequenceFlow id="f15" sourceRef="g4" targetRef="ice10"/>
    <bpmn:sequenceFlow id="f16" sourceRef="g4" targetRef="ice11"/>
    <bpmn:sequenceFlow id="f17" sourceRef="g4" targetRef="ice12"/>
    <bpmn:sequenceFlow id="f18" sourceRef="ice10" targetRef="t12"/>
    <bpmn:sequenceFlow id="f19" sourceRef="ice11" targetRef="t12"/>
    <bpmn:sequenceFlow id="f20" sourceRef="ice12" targetRef="t13"/>
    <bpmn:sequenceFlow id="f21" sourceRef="t12" targetRef="ee8"/>
    <bpmn:sequenceFlow id="f22" sourceRef="t13" targetRef="ee8"/>
  </bpmn:process>
</bpmn:definitions>