      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_dup2" bpmnElement="f6">
        <di:waypoint x="600" y="180"/>
        <di:waypoint x="700" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_dup2" bpmnElement="f7">
        <di:waypoint x="700" y="180"/>
        <di:waypoint x="800" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_dup2" bpmnElement="f8">
        <di:waypoint x="800" y="180"/>
