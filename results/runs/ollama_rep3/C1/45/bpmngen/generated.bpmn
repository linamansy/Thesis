      <bpmndi:BPMNEdge id="mf5_dup2" bpmnElement="mf5">
        <di:waypoint x="1100" y="100"/>
        <di:waypoint x="700" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf6_dup2" bpmnElement="mf6">
        <di:waypoint x="1000" y="100"/>
        <di:waypoint x="600" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf7_dup2" bpmnElement="mf7">
        <di:waypoint x="1300" y="100"/>
        <di:waypoint x="900" y="200"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>