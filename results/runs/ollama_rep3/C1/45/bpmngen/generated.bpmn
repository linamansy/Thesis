      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_dup2" bpmnElement="f12">
        <di:waypoint x="1200" y="180"/>
        <di:waypoint x="1300" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf1_dup2" bpmnElement="mf1">
        <di:waypoint x="300" y="100"/>
        <di:waypoint x="400" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf2_dup2" bpmnElement="mf2">
        <di:waypoint x="700" y="100"/>
