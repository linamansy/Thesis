<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="E-Shop System" processRef="EShopSystemProcess"/>
    <bpmn:messageFlow id="mf1" name="Login Confirmation" sourceRef="t1" targetRef="ice1"/>
    <bpmn:messageFlow id="mf2" name="Add Product" sourceRef="t3" targetRef="se2"/>
    <bpmn:messageFlow id="mf3" name="Product Saved" sourceRef="t4" targetRef="ice2"/>
    <bpmn:messageFlow id="mf4" name="Payment Confirmation" sourceRef="ice4" targetRef="t6"/>
    <bpmn:messageFlow id="mf5" name="Shipping Address" sourceRef="t7" targetRef="ice3"/>
    <bpmn:messageFlow id="mf6" name="Payment Data" sourceRef="t5" targetRef="ice4"/>
    <bpmn:messageFlow id="mf7" name="Order Finished" sourceRef="ice4" targetRef="ee2"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Start Shopping"/>
    <bpmn:task id="t1" name="Login"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Login Confirmed">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g1" name="Login Successful?"/>
    <bpmn:task id="t2" name="Select Product"/>
    <bpmn:task id="t3" name="Add to Cart"/>
    <bpmn:task id="t4" name="Save Product"/>
    <bpmn:exclusiveGateway id="g2" name="All Products Selected?"/>
    <bpmn:task id="t5" name="Enter Payment Data"/>
    <bpmn:intermediateCatchEvent id="ice2" name="Product Saved">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Shipping Address Entered">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice4" name="Payment Confirmed">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Order Finished"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="g1"/>
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f8" sourceRef="ice2" targetRef="g2"/>
    <bpmn:sequenceFlow id="f9" sourceRef="g2" targetRef="t5"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t5" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f11" sourceRef="ice3" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f12" sourceRef="ice4" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="EShopSystemProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Product Selected">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:startEvent>
    <bpmn:task id="t1_dup2" name="Check Product"/>
    <bpmn:task id="t2_dup2" name="Prepare Order"/>
    <bpmn:task id="t3_dup2" name="Prepare Payment"/>
    <bpmn:task id="t4_dup2" name="Prepare Shipment"/>
    <bpmn:endEvent id="ee1_dup2" name="Order Finished"/>
    <bpmn:sequenceFlow id="f1_dup2" sourceRef="se2" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2_dup2" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f3_dup2" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f4_dup2" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f5_dup2" sourceRef="t4" targetRef="ee1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collab1">
      <bpmndi:BPMNShape id="p1_dup2" bpmnElement="Customer" isHorizontal="true">
        <dc:Bounds x="100" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_dup2" bpmnElement="E-Shop System" isHorizontal="true">
        <dc:Bounds x="400" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se1_dup2" bpmnElement="se1">
        <dc:Bounds x="100" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_dup3" bpmnElement="t1">
        <dc:Bounds x="200" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice1_dup2" bpmnElement="ice1">
        <dc:Bounds x="300" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_dup2" bpmnElement="g1">
        <dc:Bounds x="400" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_dup3" bpmnElement="t2">
        <dc:Bounds x="500" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_dup3" bpmnElement="t3">
        <dc:Bounds x="600" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_dup3" bpmnElement="t4">
        <dc:Bounds x="700" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice2_dup2" bpmnElement="ice2">
        <dc:Bounds x="800" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_dup2" bpmnElement="g2">
        <dc:Bounds x="900" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_dup2" bpmnElement="t5">
        <dc:Bounds x="1000" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice3_dup2" bpmnElement="ice3">
        <dc:Bounds x="1100" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice4_dup2" bpmnElement="ice4">
        <dc:Bounds x="1200" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee1_dup3" bpmnElement="ee1">
        <dc:Bounds x="1300" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se2_dup2" bpmnElement="se2">
        <dc:Bounds x="400" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_1" bpmnElement="t1">
        <dc:Bounds x="500" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_1" bpmnElement="t2">
        <dc:Bounds x="600" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_1" bpmnElement="t3">
        <dc:Bounds x="700" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_1" bpmnElement="t4">
        <dc:Bounds x="800" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee1_1" bpmnElement="ee1">
        <dc:Bounds x="900" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_dup3" bpmnElement="f1">
        <di:waypoint x="100" y="180"/>
        <di:waypoint x="200" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_dup3" bpmnElement="f2">
        <di:waypoint x="200" y="180"/>
        <di:waypoint x="300" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_dup3" bpmnElement="f3">
        <di:waypoint x="300" y="180"/>
        <di:waypoint x="400" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_dup3" bpmnElement="f4">
        <di:waypoint x="400" y="180"/>
        <di:waypoint x="500" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_dup3" bpmnElement="f5">
        <di:waypoint x="500" y="180"/>
