<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Procurement Team" processRef="ProcurementProcess"/>
    <bpmn:participant id="p2" name="Suppliers" processRef="SuppliersProcess"/>
  </bpmn:collaboration>
  <bpmn:process id="ProcurementProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Identify Need"/>
    <bpmn:task id="t1" name="Issue RFP"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Receive Responses">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t2" name="Evaluate Proposals"/>
    <bpmn:task id="t3" name="Conduct Site Visits/Interviews"/>
    <bpmn:exclusiveGateway id="g1" name="Select Supplier"/>
    <bpmn:task id="t4" name="Negotiate Contract"/>
    <bpmn:intermediateCatchEvent id="ice2" name="Agree on Terms">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t5" name="Sign Contract"/>
    <bpmn:endEvent id="ee1" name="Supplier Onboarded"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t3" targetRef="g1"/>
    <bpmn:sequenceFlow id="f6" sourceRef="g1" targetRef="t4"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f8" sourceRef="ice2" targetRef="t5"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="SuppliersProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Receive RFP">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:startEvent>
    <bpmn:task id="t6" name="Submit Proposal"/>
    <bpmn:intermediateCatchEvent id="ice3" name="Proposal Evaluated">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t7" name="Prepare for Site Visit"/>
    <bpmn:intermediateCatchEvent id="ice4" name="Site Visit Completed">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t8" name="Negotiate Terms"/>
    <bpmn:intermediateCatchEvent id="ice5" name="Terms Agreed">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t9" name="Sign Contract"/>
    <bpmn:endEvent id="ee2" name="Onboarding Complete"/>
    <bpmn:sequenceFlow id="f10" sourceRef="se2" targetRef="t6"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t6" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f12" sourceRef="ice3" targetRef="t7"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t7" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f14" sourceRef="ice4" targetRef="t8"/>
    <bpmn:sequenceFlow id="f15" sourceRef="t8" targetRef="ice5"/>
    <bpmn:sequenceFlow id="f16" sourceRef="ice5" targetRef="t9"/>
    <bpmn:sequenceFlow id="f17" sourceRef="t9" targetRef="ee2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram1">
    <bpmndi:BPMNPlane id="BPMNPlane1" bpmnElement="collab1">
      <bpmndi:BPMNShape id="p1_dup2" bpmnElement="Procurement Team">
        <dc:Bounds x="100" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_dup2" bpmnElement="Suppliers">
        <dc:Bounds x="500" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se1_dup2" bpmnElement="Identify Need">
        <dc:Bounds x="80" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_dup2" bpmnElement="Issue RFP">
        <dc:Bounds x="200" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice1_dup2" bpmnElement="Receive Responses">
        <dc:Bounds x="320" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_dup2" bpmnElement="Evaluate Proposals">
        <dc:Bounds x="440" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_dup2" bpmnElement="Conduct Site Visits/Interviews">
        <dc:Bounds x="560" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_dup2" bpmnElement="Select Supplier">
        <dc:Bounds x="680" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_dup2" bpmnElement="Negotiate Contract">
        <dc:Bounds x="800" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice2_dup2" bpmnElement="Agree on Terms">
        <dc:Bounds x="920" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_dup2" bpmnElement="Sign Contract">
        <dc:Bounds x="1040" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee1_dup2" bpmnElement="Supplier Onboarded">
        <dc:Bounds x="1160" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se2_dup2" bpmnElement="Receive RFP">
        <dc:Bounds x="500" y="340" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_dup2" bpmnElement="Submit Proposal">
        <dc:Bounds x="620" y="340" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice3_dup2" bpmnElement="Proposal Evaluated">
        <dc:Bounds x="740" y="340" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_dup2" bpmnElement="Prepare for Site Visit">
        <dc:Bounds x="860" y="340" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice4_dup2" bpmnElement="Site Visit Completed">
        <dc:Bounds x="980" y="340" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_dup2" bpmnElement="Negotiate Terms">
        <dc:Bounds x="1100" y="340" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice5_dup2" bpmnElement="Terms Agreed">
        <dc:Bounds x="1220" y="340" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t9_dup2" bpmnElement="Sign Contract">
        <dc:Bounds x="1340" y="340" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee2_dup2" bpmnElement="Onboarding Complete">
        <dc:Bounds x="1460" y="340" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_dup2" sourceRef="se1" targetRef="t1">
        <di:waypoint x="180" y="220"/>
        <di:waypoint x="200" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_dup2" sourceRef="t1" targetRef="ice1">
        <di:waypoint x="200" y="220"/>
        <di:waypoint x="320" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_dup2" sourceRef="ice1" targetRef="t2">
        <di:waypoint x="320" y="220"/>
        <di:waypoint x="440" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_dup2" sourceRef="t2" targetRef="t3">
        <di:waypoint x="440" y="220"/>
        <di:waypoint x="560" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_dup2" sourceRef="t3" targetRef="g1">
        <di:waypoint x="560" y="220"/>
        <di:waypoint x="680" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_dup2" sourceRef="g1" targetRef="t4">
        <di:waypoint x="680" y="220"/>
        <di:waypoint x="800" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_dup2" sourceRef="t4" targetRef="ice2">
        <di:waypoint x="800" y="220"/>
        <di:waypoint x="920" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_dup2" sourceRef="ice2" targetRef="t5">
        <di:waypoint x="920" y="220"/>
        <di:waypoint x="1040" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_dup2" sourceRef="t5" targetRef="ee1">
        <di:waypoint x="1040" y="220"/>
        <di:waypoint x="1160" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_dup2" sourceRef="se2" targetRef="t6">
        <di:waypoint x="500" y="400"/>
        <di:waypoint x="620" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_dup2" sourceRef="t6" targetRef="ice3">
        <di:waypoint x="620" y="400"/>
        <di:waypoint x="740" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_dup2" sourceRef="ice3" targetRef="t7">
        <di:waypoint x="740" y="400"/>
        <di:waypoint x="860" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_dup2" sourceRef="t7" targetRef="ice4">
        <di:waypoint x="860" y="400"/>
        <di:waypoint x="980" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f14_dup2" sourceRef="ice4" targetRef="t8">
        <di:waypoint x="980" y="400"/>
        <di:waypoint x="1100" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f15_dup2" sourceRef="t8" targetRef="ice5">
        <di:waypoint x="1100" y="400"/>
        <di:waypoint x="1220" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f16_dup2" sourceRef="ice5" targetRef="t9">
        <di:waypoint x="1220" y="400"/>
        <di:waypoint x="1340" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f17_dup2" sourceRef="t9" targetRef="ee2">
        <di:waypoint x="1340" y="400"/>
        <di:waypoint x="1460" y="400"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>