<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Employee/Department" processRef="EmployeeProcess"/>
    <bpmn:participant id="p2" name="IT" processRef="ITProcess"/>
    <bpmn:messageFlow id="mf1" name="Request Submission" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Request Approval" sourceRef="ice1" targetRef="t3"/>
    <bpmn:messageFlow id="mf3" name="Solution Procurement" sourceRef="t4" targetRef="se5"/>
    <bpmn:messageFlow id="mf4" name="Solution Deployment" sourceRef="t6" targetRef="se7"/>
    <bpmn:messageFlow id="mf5" name="Training and Support" sourceRef="t7" targetRef="ee8"/>
  </bpmn:collaboration>
  <bpmn:process id="EmployeeProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Submit Request"/>
    <bpmn:task id="t1" name="Submit IT Request"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Request Approved">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee8" name="Request Complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="ee8"/>
  </bpmn:process>
  <bpmn:process id="ITProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Request Received">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:startEvent>
    <bpmn:task id="t2" name="Assess Request"/>
    <bpmn:exclusiveGateway id="g1" name="Approval Decision"/>
    <bpmn:task id="t3" name="Approve Request"/>
    <bpmn:task id="t4" name="Procure Solution"/>
    <bpmn:task id="t5" name="Install Solution"/>
    <bpmn:task id="t6" name="Test Solution"/>
    <bpmn:task id="t7" name="Provide Training and Support"/>
    <bpmn:endEvent id="ee8_dup2" name="Request Complete"/>
    <bpmn:sequenceFlow id="f4" sourceRef="se2" targetRef="t2"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t2" targetRef="g1"/>
    <bpmn:sequenceFlow id="f6" sourceRef="g1" targetRef="t3"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t7" targetRef="ee8"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram1">
    <bpmndi:BPMNPlane id="BPMNPlane1" bpmnElement="collab1">
      <bpmndi:BPMNShape id="EmployeeProcess_1" bpmnElement="se1">
        <dc:Bounds x="100" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EmployeeProcess_2" bpmnElement="t1">
        <dc:Bounds x="220" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EmployeeProcess_3" bpmnElement="ice1">
        <dc:Bounds x="340" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EmployeeProcess_4" bpmnElement="ee8">
        <dc:Bounds x="460" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_1" bpmnElement="se2">
        <dc:Bounds x="100" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_2" bpmnElement="t2">
        <dc:Bounds x="220" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_3" bpmnElement="g1">
        <dc:Bounds x="340" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_4" bpmnElement="t3">
        <dc:Bounds x="460" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_5" bpmnElement="t4">
        <dc:Bounds x="580" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_6" bpmnElement="t5">
        <dc:Bounds x="700" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_7" bpmnElement="t6">
        <dc:Bounds x="820" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_8" bpmnElement="t7">
        <dc:Bounds x="940" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ITProcess_9" bpmnElement="ee8">
        <dc:Bounds x="1060" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_dup2" bpmnElement="EmployeeProcess">
        <dc:Bounds x="0" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_dup2" bpmnElement="ITProcess">
        <dc:Bounds x="0" y="220" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_dup2" sourceRef="se1" targetRef="t1">
        <di:waypoint x="100" y="140"/>
        <di:waypoint x="220" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_dup2" sourceRef="t1" targetRef="ice1">
        <di:waypoint x="220" y="140"/>
        <di:waypoint x="340" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_dup2" sourceRef="ice1" targetRef="ee8">
        <di:waypoint x="340" y="140"/>
        <di:waypoint x="460" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_dup2" sourceRef="se2" targetRef="t2">
        <di:waypoint x="100" y="260"/>
        <di:waypoint x="220" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_dup2" sourceRef="t2" targetRef="g1">
        <di:waypoint x="220" y="260"/>
        <di:waypoint x="340" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_dup2" sourceRef="g1" targetRef="t3">
        <di:waypoint x="340" y="260"/>
        <di:waypoint x="460" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_dup2" sourceRef="t3" targetRef="t4">
        <di:waypoint x="460" y="260"/>
        <di:waypoint x="580" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_dup2" sourceRef="t4" targetRef="t5">
        <di:waypoint x="580" y="260"/>
        <di:waypoint x="700" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_dup2" sourceRef="t5" targetRef="t6">
        <di:waypoint x="700" y="260"/>
        <di:waypoint x="820" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_dup2" sourceRef="t6" targetRef="t7">
        <di:waypoint x="820" y="260"/>
        <di:waypoint x="940" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_dup2" sourceRef="t7" targetRef="ee8">
        <di:waypoint x="940" y="260"/>
        <di:waypoint x="1060" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf1_dup2" sourceRef="t1" targetRef="se2">
        <di:waypoint x="220" y="140"/>
        <di:waypoint x="100" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf2_dup2" sourceRef="ice1" targetRef="t3">
        <di:waypoint x="340" y="140"/>
        <di:waypoint x="460" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf3_dup2" sourceRef="t4" targetRef="se5">
        <di:waypoint x="580" y="260"/>
        <di:waypoint x="100" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf4_dup2" sourceRef="t6" targetRef="se7">
        <di:waypoint x="820" y="260"/>
        <di:waypoint x="100" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf5_dup2" sourceRef="t7" targetRef="ee8">
        <di:waypoint x="940" y="260"/>
        <di:waypoint x="1060" y="260"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>