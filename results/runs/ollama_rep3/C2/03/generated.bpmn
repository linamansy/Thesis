      <bpmndi:BPMNShape id="t3_1" bpmnElement="t3">
        <dc:Bounds x="420" y="120" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice3_1" bpmnElement="ice3">
        <dc:Bounds x="500" y="120" width="36" height="36"/>
