<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Warehouse" processRef="WarehouseProcess"/>
    <bpmn:participant id="p2" name="Procurement Team" processRef="ProcurementProcess"/>
    <bpmn:participant id="p3" name="Supplier" processRef="SupplierProcess"/>
    <bpmn:messageFlow id="mf1" name="Inventory Alert" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Order Placed" sourceRef="t3" targetRef="se4"/>
    <bpmn:messageFlow id="mf3" name="Order Confirmation" sourceRef="t5" targetRef="ice1"/>
    <bpmn:messageFlow id="mf4" name="Stock Received" sourceRef="t7" targetRef="ice2"/>
    <bpmn:messageFlow id="mf5" name="Stock Updated" sourceRef="t9" targetRef="ee1"/>
  </bpmn:collaboration>
  <bpmn:process id="WarehouseProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Monitor Inventory"/>
    <bpmn:task id="t1" name="Check Inventory Level"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Stock Received">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Inventory Updated">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Inventory Process Complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="ice2" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="ProcurementProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Reorder Signal">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:startEvent>
    <bpmn:task id="t3" name="Place Order"/>
    <bpmn:intermediateCatchEvent id="ice3" name="Order Confirmation">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee2" name="Order Process Complete"/>
    <bpmn:sequenceFlow id="f5" sourceRef="se2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f7" sourceRef="ice3" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="SupplierProcess" isExecutable="false">
    <bpmn:startEvent id="se4" name="Order Received">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:startEvent>
    <bpmn:task id="t5" name="Prepare Stock"/>
    <bpmn:task id="t6" name="Ship Stock"/>
    <bpmn:intermediateCatchEvent id="ice4" name="Stock Received">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee3" name="Stock Shipped"/>
    <bpmn:sequenceFlow id="f8" sourceRef="se4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f11" sourceRef="ice4" targetRef="ee3"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram1">
    <bpmndi:BPMNPlane id="BPMNPlane1" bpmnElement="collab1">
      <bpmndi:BPMNShape id="WarehouseProcess_1" bpmnElement="WarehouseProcess">
        <dc:Bounds x="100" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ProcurementProcess_1" bpmnElement="ProcurementProcess">
        <dc:Bounds x="300" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SupplierProcess_1" bpmnElement="SupplierProcess">
        <dc:Bounds x="500" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se1_1" bpmnElement="se1">
