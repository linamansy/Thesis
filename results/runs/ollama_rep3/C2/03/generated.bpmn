      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_1" bpmnElement="t5">
        <dc:Bounds x="680" y="120" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_1" bpmnElement="t6">
        <dc:Bounds x="720" y="120" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice4_1" bpmnElement="ice4">
        <dc:Bounds x="760" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee3_1" bpmnElement="ee3">
        <dc:Bounds x="800" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_1" bpmnElement="f1">
        <di:waypoint x="100" y="120"/>
        <di:waypoint x="80" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_1" bpmnElement="f2">
