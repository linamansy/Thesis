<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Order Management System" processRef="OrderManagementProcess"/>
    <bpmn:participant id="p2" name="Warehouse" processRef="WarehouseProcess"/>
    <bpmn:participant id="p3" name="Stock Management System" processRef="StockManagementProcess"/>
    <bpmn:participant id="p4" name="Wholesaler" processRef="WholesalerProcess"/>
    <bpmn:participant id="p5" name="Courier" processRef="CourierProcess"/>
    <bpmn:messageFlow id="mf1" name="Order Read" sourceRef="se1" targetRef="t1"/>
    <bpmn:messageFlow id="mf2" name="Check Stock" sourceRef="t1" targetRef="ice1"/>
    <bpmn:messageFlow id="mf3" name="In Stock" sourceRef="ice1" targetRef="t2"/>
    <bpmn:messageFlow id="mf4" name="Out of Stock" sourceRef="ice1" targetRef="t3"/>
    <bpmn:messageFlow id="mf5" name="Withdraw Product" sourceRef="t2" targetRef="se2"/>
    <bpmn:messageFlow id="mf6" name="Reorder Product" sourceRef="t3" targetRef="se3"/>
    <bpmn:messageFlow id="mf7" name="Product Arrived" sourceRef="t4" targetRef="t5"/>
    <bpmn:messageFlow id="mf8" name="Register Stock" sourceRef="t5" targetRef="se4"/>
    <bpmn:messageFlow id="mf9" name="Order Ready" sourceRef="t6" targetRef="t7"/>
    <bpmn:messageFlow id="mf10" name="Request Courier" sourceRef="t7" targetRef="se5"/>
    <bpmn:messageFlow id="mf11" name="Pack and Ship" sourceRef="t8" targetRef="ee1"/>
    <bpmn:messageFlow id="mf12" name="Next Product" sourceRef="t6" targetRef="t1"/>
  </bpmn:collaboration>
  <bpmn:process id="OrderManagementProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Order Read"/>
    <bpmn:task id="t1" name="Read Order"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Check Stock">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g1" name="In Stock or Not"/>
    <bpmn:task id="t2" name="Withdraw Product"/>
    <bpmn:task id="t3" name="Reorder Product"/>
    <bpmn:task id="t4" name="Wait for Product"/>
    <bpmn:task id="t5" name="Register Stock"/>
    <bpmn:task id="t6" name="Check Order Completion"/>
    <bpmn:task id="t7" name="Request Courier"/>
    <bpmn:task id="t8" name="Pack and Ship"/>
    <bpmn:endEvent id="ee1" name="Order Shipped"/>
    <bpmn:endEvent id="ee2" name="Order Not Ready"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="g1"/>
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f5" sourceRef="g1" targetRef="t3"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t2" targetRef="t4"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t8" targetRef="ee1"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t6" targetRef="ee2"/>
  
    <bpmn:sequenceFlow id="auto_link_out_ee1_to_ee2" sourceRef="ee1" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="WarehouseProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Withdraw Product"/>
    <bpmn:task id="t9" name="Withdraw Product from Warehouse"/>
    <bpmn:endEvent id="ee3" name="Product Withdrawn"/>
    <bpmn:sequenceFlow id="f14" sourceRef="se2" targetRef="t9"/>
    <bpmn:sequenceFlow id="f15" sourceRef="t9" targetRef="ee3"/>
  </bpmn:process>
  <bpmn:process id="StockManagementProcess" isExecutable="false">
    <bpmn:startEvent id="se4" name="Register Stock"/>
    <bpmn:task id="t10" name="Register Product in Stock"/>
    <bpmn:endEvent id="ee4" name="Stock Registered"/>
    <bpmn:sequenceFlow id="f16" sourceRef="se4" targetRef="t10"/>
    <bpmn:sequenceFlow id="f17" sourceRef="t10" targetRef="ee4"/>
  </bpmn:process>
  <bpmn:process id="WholesalerProcess" isExecutable="false">
    <bpmn:startEvent id="se3" name="Reorder Product"/>
    <bpmn:task id="t11" name="Place Reorder Request"/>
    <bpmn:intermediateCatchEvent id="ice2" name="Product Arrived">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t12" name="Wait for Product (10 Days)"/>
    <bpmn:exclusiveGateway id="g2" name="Delay Penalty"/>
    <bpmn:task id="t13" name="Demand Delay Penalty"/>
    <bpmn:endEvent id="ee5" name="Product Received"/>
    <bpmn:sequenceFlow id="f18" sourceRef="se3" targetRef="t11"/>
    <bpmn:sequenceFlow id="f19" sourceRef="t11" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f20" sourceRef="ice2" targetRef="t12"/>
    <bpmn:sequenceFlow id="f21" sourceRef="t12" targetRef="g2"/>
    <bpmn:sequenceFlow id="f22" sourceRef="g2" targetRef="t13"/>
    <bpmn:sequenceFlow id="f23" sourceRef="t13" targetRef="ee5"/>
  </bpmn:process>
  <bpmn:process id="CourierProcess" isExecutable="false">
    <bpmn:startEvent id="se5" name="Request Courier"/>
    <bpmn:task id="t14" name="Request Courier Service"/>
    <bpmn:task id="t15" name="Pack Products"/>
    <bpmn:task id="t16" name="Ship Products"/>
    <bpmn:endEvent id="ee6" name="Order Shipped"/>
    <bpmn:sequenceFlow id="f24" sourceRef="se5" targetRef="t14"/>
    <bpmn:sequenceFlow id="f25" sourceRef="t14" targetRef="t15"/>
    <bpmn:sequenceFlow id="f26" sourceRef="t15" targetRef="t16"/>
    <bpmn:sequenceFlow id="f27" sourceRef="t16" targetRef="ee6"/>
  </bpmn:process>
</bpmn:definitions>