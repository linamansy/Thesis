<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="System" processRef="SystemProcess"/>
    <bpmn:participant id="p3" name="Inventory System" processRef="InventorySystemProcess"/>
    <bpmn:participant id="p4" name="Warehouse" processRef="WarehouseProcess"/>
    <bpmn:participant id="p5" name="Quality Control" processRef="QualityControlProcess"/>
    <bpmn:participant id="p6" name="Packaging" processRef="PackagingProcess"/>
    <bpmn:participant id="p7" name="Shipping" processRef="ShippingProcess"/>
    <bpmn:participant id="p8" name="Returns" processRef="ReturnsProcess"/>
    <bpmn:messageFlow id="mf1" name="Place Order" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Payment Confirmation" sourceRef="t3" targetRef="ice1"/>
    <bpmn:messageFlow id="mf3" name="Payment Failed" sourceRef="ice1" targetRef="t4"/>
    <bpmn:messageFlow id="mf4" name="Stock Check" sourceRef="t5" targetRef="se6"/>
    <bpmn:messageFlow id="mf5" name="Out of Stock" sourceRef="ice2" targetRef="t6"/>
    <bpmn:messageFlow id="mf6" name="In Stock" sourceRef="ice3" targetRef="t7"/>
    <bpmn:messageFlow id="mf7" name="Pick Items" sourceRef="t7" targetRef="se8"/>
    <bpmn:messageFlow id="mf8" name="Quality Check" sourceRef="t8" targetRef="se9"/>
    <bpmn:messageFlow id="mf9" name="Packaging" sourceRef="t9" targetRef="se10"/>
    <bpmn:messageFlow id="mf10" name="Gift Wrap" sourceRef="t10" targetRef="se11"/>
    <bpmn:messageFlow id="mf11" name="Shipping Documents" sourceRef="t11" targetRef="se12"/>
    <bpmn:messageFlow id="mf12" name="Customs Docs" sourceRef="t12" targetRef="se13"/>
    <bpmn:messageFlow id="mf13" name="Dispatch" sourceRef="t13" targetRef="se14"/>
    <bpmn:messageFlow id="mf14" name="Shipping Confirmation" sourceRef="t14" targetRef="ice4"/>
    <bpmn:messageFlow id="mf15" name="Inventory Update" sourceRef="t15" targetRef="se16"/>
    <bpmn:messageFlow id="mf16" name="Feedback Email" sourceRef="t16" targetRef="se17"/>
    <bpmn:messageFlow id="mf17" name="Return Request" sourceRef="t17" targetRef="se18"/>
    <bpmn:messageFlow id="mf18" name="Return Label" sourceRef="t18" targetRef="ice5"/>
    <bpmn:messageFlow id="mf19" name="Receive Return" sourceRef="t19" targetRef="se20"/>
    <bpmn:messageFlow id="mf20" name="Inspect Return" sourceRef="t20" targetRef="se21"/>
    <bpmn:messageFlow id="mf21" name="Refund/Replace" sourceRef="t21" targetRef="ee22"/>
    <bpmn:messageFlow id="mf22" name="No Issue" sourceRef="ice6" targetRef="ee23"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Order Placed"/>
    <bpmn:task id="t1" name="Place Order"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Payment Failed">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Out of Stock">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="In Stock">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice4" name="Shipping Confirmed">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice5" name="Return Label">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice6" name="No Issue">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Order Complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="t1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t1" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="ice1" targetRef="ee1"/>
    <bpmn:sequenceFlow id="f6" sourceRef="ice2" targetRef="ee1"/>
    <bpmn:sequenceFlow id="f7" sourceRef="ice3" targetRef="ee1"/>
    <bpmn:sequenceFlow id="f8" sourceRef="ice4" targetRef="ee1"/>
    <bpmn:sequenceFlow id="f9" sourceRef="ice5" targetRef="ee1"/>
    <bpmn:sequenceFlow id="f10" sourceRef="ice6" targetRef="ee1"/>
  
    <bpmn:sequenceFlow id="auto_link_in_ice3_to_ice4" sourceRef="ice3" targetRef="ice4"/>
    <bpmn:sequenceFlow id="auto_link_in_ice4_to_ice5" sourceRef="ice4" targetRef="ice5"/>
    <bpmn:sequenceFlow id="auto_link_in_ice5_to_ice6" sourceRef="ice5" targetRef="ice6"/>
  </bpmn:process>
  <bpmn:process id="SystemProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Order Received"/>
    <bpmn:task id="t3" name="Process Payment"/>
    <bpmn:intermediateCatchEvent id="ice1_dup2" name="Payment Failed">
      <bpmn:messageEventDefinition id="med1_dup2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2_dup2" name="Out of Stock">
      <bpmn:messageEventDefinition id="med2_dup2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3_dup2" name="In Stock">
      <bpmn:messageEventDefinition id="med3_dup2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice4_dup2" name="Shipping Confirmed">
      <bpmn:messageEventDefinition id="med4_dup2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice5_dup2" name="Return Label">
      <bpmn:messageEventDefinition id="med5_dup2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice6_dup2" name="No Issue">
      <bpmn:messageEventDefinition id="med6_dup2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee2" name="Order Complete"/>
    <bpmn:sequenceFlow id="f11" sourceRef="se2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t3" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t3" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f14" sourceRef="t3" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f15" sourceRef="t3" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f16" sourceRef="t3" targetRef="ice5"/>
    <bpmn:sequenceFlow id="f17" sourceRef="t3" targetRef="ice6"/>
    <bpmn:sequenceFlow id="f18" sourceRef="ice1" targetRef="ee2"/>
    <bpmn:sequenceFlow id="f19" sourceRef="ice2" targetRef="ee2"/>
    <bpmn:sequenceFlow id="f20" sourceRef="ice3" targetRef="ee2"/>
    <bpmn:sequenceFlow id="f21" sourceRef="ice4" targetRef="ee2"/>
    <bpmn:sequenceFlow id="f22" sourceRef="ice5" targetRef="ee2"/>
    <bpmn:sequenceFlow id="f23" sourceRef="ice6" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="InventorySystemProcess" isExecutable="false">
    <bpmn:startEvent id="se6" name="Stock Check"/>
    <bpmn:task id="t5" name="Check Stock Availability"/>
    <bpmn:intermediateCatchEvent id="ice2_dup3" name="Out of Stock">
      <bpmn:messageEventDefinition id="med2_dup3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3_dup3" name="In Stock">
      <bpmn:messageEventDefinition id="med3_dup3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee3" name="Stock Check Complete"/>
    <bpmn:sequenceFlow id="f24" sourceRef="se6" targetRef="t5"/>
    <bpmn:sequenceFlow id="f25" sourceRef="t5" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f26" sourceRef="t5" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f27" sourceRef="ice2" targetRef="ee3"/>
    <bpmn:sequenceFlow id="f28" sourceRef="ice3" targetRef="ee3"/>
  </bpmn:process>
  <bpmn:process id="WarehouseProcess" isExecutable="false">
    <bpmn:startEvent id="se8" name="Pick Items"/>
    <bpmn:task id="t7" name="Pick Items from Warehouse"/>
    <bpmn:endEvent id="ee4" name="Items Picked"/>
    <bpmn:sequenceFlow id="f29" sourceRef="se8" targetRef="t7"/>
    <bpmn:sequenceFlow id="f30" sourceRef="t7" targetRef="ee4"/>
  </bpmn:process>
  <bpmn:process id="QualityControlProcess" isExecutable="false">
    <bpmn:startEvent id="se9" name="Quality Check"/>
    <bpmn:task id="t8" name="Quality Control Check"/>
    <bpmn:endEvent id="ee5" name="Quality Check Complete"/>
    <bpmn:sequenceFlow id="f31" sourceRef="se9" targetRef="t8"/>
    <bpmn:sequenceFlow id="f32" sourceRef="t8" targetRef="ee5"/>
  </bpmn:process>
  <bpmn:process id="PackagingProcess" isExecutable="false">
    <bpmn:startEvent id="se10" name="Packaging"/>
    <bpmn:task id="t9" name="Pack Items"/>
    <bpmn:task id="t10" name="Gift Wrap"/>
    <bpmn:endEvent id="ee6" name="Packaging Complete"/>
    <bpmn:sequenceFlow id="f33" sourceRef="se10" targetRef="t9"/>
    <bpmn:sequenceFlow id="f34" sourceRef="t9" targetRef="t10"/>
    <bpmn:sequenceFlow id="f35" sourceRef="t10" targetRef="ee6"/>
  </bpmn:process>
  <bpmn:process id="ShippingProcess" isExecutable="false">
    <bpmn:startEvent id="se12" name="Shipping Documents"/>
    <bpmn:task id="t11" name="Prepare Shipping Documents"/>
    <bpmn:task id="t12" name="Prepare Customs Docs"/>
    <bpmn:intermediateCatchEvent id="ice4_dup3" name="Shipping Confirmed">
      <bpmn:messageEventDefinition id="med4_dup3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee7" name="Shipping Complete"/>
    <bpmn:sequenceFlow id="f36" sourceRef="se12" targetRef="t11"/>
    <bpmn:sequenceFlow id="f37" sourceRef="t11" targetRef="t12"/>
    <bpmn:sequenceFlow id="f38" sourceRef="t12" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f39" sourceRef="ice4" targetRef="ee7"/>
  </bpmn:process>
  <bpmn:process id="ReturnsProcess" isExecutable="false">
    <bpmn:startEvent id="se18" name="Return Request"/>
    <bpmn:task id="t17" name="Generate Return Label"/>
    <bpmn:intermediateCatchEvent id="ice5_dup3" name="Return Label">
      <bpmn:messageEventDefinition id="med5_dup3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t18" name="Send Return Label"/>
    <bpmn:startEvent id="se19" name="Receive Return"/>
    <bpmn:task id="t19" name="Receive Returned Items"/>
    <bpmn:task id="t20" name="Inspect Returned Items"/>
    <bpmn:task id="t21" name="Process Refund/Replace"/>
    <bpmn:endEvent id="ee8" name="Return Process Complete"/>
    <bpmn:sequenceFlow id="f40" sourceRef="se18" targetRef="t17"/>
    <bpmn:sequenceFlow id="f41" sourceRef="t17" targetRef="ice5"/>
    <bpmn:sequenceFlow id="f42" sourceRef="ice5" targetRef="t18"/>
    <bpmn:sequenceFlow id="f43" sourceRef="t18" targetRef="se19"/>
    <bpmn:sequenceFlow id="f44" sourceRef="se19" targetRef="t19"/>
    <bpmn:sequenceFlow id="f45" sourceRef="t19" targetRef="t20"/>
    <bpmn:sequenceFlow id="f46" sourceRef="t20" targetRef="t21"/>
    <bpmn:sequenceFlow id="f47" sourceRef="t21" targetRef="ee8"/>
  </bpmn:process>
</bpmn:definitions>