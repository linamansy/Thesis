<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="Sales Team" processRef="SalesProcess"/>
    <bpmn:messageFlow id="mf1" name="Inquiry" sourceRef="se1" targetRef="t1"/>
    <bpmn:messageFlow id="mf2" name="Quote" sourceRef="t3" targetRef="ice1"/>
    <bpmn:messageFlow id="mf3" name="Order Confirmation" sourceRef="t5" targetRef="ice2"/>
    <bpmn:messageFlow id="mf4" name="Bill" sourceRef="t7" targetRef="ice3"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Inquiry"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Quote Approved">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Order Confirmed">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Bill Received">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Order Complete"/>
    
    
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="ice2" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="ice3" targetRef="ee1"/>
  
    <bpmn:sequenceFlow id="auto_link_out_se1_to_ice2" sourceRef="se1" targetRef="ice2"/>
  </bpmn:process>
  <bpmn:process id="SalesProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Inquiry Received">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Collect Information"/>
    <bpmn:task id="t2" name="Address Concerns"/>
    <bpmn:task id="t3" name="Provide Quote"/>
    <bpmn:task id="t4" name="Record Order"/>
    <bpmn:task id="t5" name="Send Confirmation"/>
    <bpmn:task id="t6" name="Send Bill"/>
    <bpmn:endEvent id="ee2" name="Done"/>
    <bpmn:sequenceFlow id="f6" sourceRef="se2" targetRef="t1"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t6" targetRef="ee2"/>
  </bpmn:process>
</bpmn:definitions>