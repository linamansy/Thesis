        <di:waypoint x="400" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf2_dup2" bpmnElement="mf2">
        <di:waypoint x="100" y="310"/>
        <di:waypoint x="400" y="310"/>
