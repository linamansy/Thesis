      <bpmndi:BPMNEdge id="f7_dup2" bpmnElement="f7">
        <di:waypoint x="400" y="150"/>
        <di:waypoint x="400" y="230"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_dup2" bpmnElement="f8">
        <di:waypoint x="400" y="230"/>
        <di:waypoint x="400" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_dup2" bpmnElement="f9">
        <di:waypoint x="400" y="310"/>
        <di:waypoint x="400" y="390"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_dup2" bpmnElement="f10">
        <di:waypoint x="400" y="390"/>
        <di:waypoint x="400" y="470"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_dup2" bpmnElement="f11">
        <di:waypoint x="400" y="470"/>
        <di:waypoint x="400" y="550"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_dup2" bpmnElement="f12">
        <di:waypoint x="400" y="550"/>
