<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="Sales Team" processRef="SalesProcess"/>
    <bpmn:messageFlow id="mf1" name="Inquiry" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Information" sourceRef="t2" targetRef="ice1"/>
    <bpmn:messageFlow id="mf3" name="Quote" sourceRef="t3" targetRef="ice2"/>
    <bpmn:messageFlow id="mf4" name="Order Approval" sourceRef="t4" targetRef="se3"/>
    <bpmn:messageFlow id="mf5" name="Order Confirmation" sourceRef="t5" targetRef="ice3"/>
    <bpmn:messageFlow id="mf6" name="Bill Sent" sourceRef="t6" targetRef="ice4"/>
    <bpmn:messageFlow id="mf7" name="Payment" sourceRef="t7" targetRef="ee1"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Inquiry"/>
    <bpmn:task id="t1" name="Inquire About Product or Service"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Information Received">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Quote Received">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Order Confirmed">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice4" name="Bill Sent">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="Order Complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="ice1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ice1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="ice2" targetRef="ice3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="ice3" targetRef="ice4"/>
    <bpmn:sequenceFlow id="f6" sourceRef="ice4" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="SalesProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Inquiry Received">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:startEvent>
    <bpmn:task id="t2" name="Collect Information and Address Concerns"/>
    <bpmn:task id="t3" name="Provide Quote"/>
    <bpmn:task id="t4" name="Receive Order Approval"/>
    <bpmn:task id="t5" name="Record Order in System"/>
    <bpmn:task id="t6" name="Send Bill"/>
    <bpmn:task id="t7" name="Receive Payment"/>
    <bpmn:endEvent id="ee2" name="Order Complete"/>
    <bpmn:sequenceFlow id="f7" sourceRef="se2" targetRef="t2"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t7" targetRef="ee2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram1">
    <bpmndi:BPMNPlane id="BPMNPlane1" bpmnElement="collab1">
      <bpmndi:BPMNShape id="p1_dup2" bpmnElement="Customer" isHorizontal="true">
        <dc:Bounds x="100" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_dup2" bpmnElement="Sales Team" isHorizontal="true">
        <dc:Bounds x="400" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se1_dup2" bpmnElement="se1">
        <dc:Bounds x="100" y="150" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_dup2" bpmnElement="t1">
        <dc:Bounds x="100" y="230" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice1_dup2" bpmnElement="ice1">
        <dc:Bounds x="100" y="310" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice2_dup2" bpmnElement="ice2">
        <dc:Bounds x="100" y="390" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice3_dup2" bpmnElement="ice3">
        <dc:Bounds x="100" y="470" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ice4_dup2" bpmnElement="ice4">
        <dc:Bounds x="100" y="550" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee1_dup2" bpmnElement="ee1">
        <dc:Bounds x="100" y="630" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se2_dup2" bpmnElement="se2">
        <dc:Bounds x="400" y="150" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_dup2" bpmnElement="t2">
        <dc:Bounds x="400" y="230" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_dup2" bpmnElement="t3">
        <dc:Bounds x="400" y="310" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_dup2" bpmnElement="t4">
        <dc:Bounds x="400" y="390" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_dup2" bpmnElement="t5">
        <dc:Bounds x="400" y="470" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_dup2" bpmnElement="t6">
        <dc:Bounds x="400" y="550" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_dup2" bpmnElement="t7">
        <dc:Bounds x="400" y="630" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee2_dup2" bpmnElement="ee2">
        <dc:Bounds x="400" y="710" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_dup2" bpmnElement="f1">
        <di:waypoint x="100" y="150"/>
        <di:waypoint x="100" y="230"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_dup2" bpmnElement="f2">
        <di:waypoint x="100" y="230"/>
        <di:waypoint x="100" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_dup2" bpmnElement="f3">
        <di:waypoint x="100" y="310"/>
        <di:waypoint x="100" y="390"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_dup2" bpmnElement="f4">
        <di:waypoint x="100" y="390"/>
        <di:waypoint x="100" y="470"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_dup2" bpmnElement="f5">
