      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ee1" bpmnElement="ee1">
        <dc:Bounds x="1000" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_se2" bpmnElement="se2">
        <dc:Bounds x="100" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_t3" bpmnElement="t3">
        <dc:Bounds x="250" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_t4" bpmnElement="t4">
        <dc:Bounds x="400" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ee2" bpmnElement="ee2">
        <dc:Bounds x="550" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_se4" bpmnElement="se4">
        <dc:Bounds x="100" y="420" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_t5" bpmnElement="t5">
        <dc:Bounds x="250" y="420" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_t6" bpmnElement="t6">
        <dc:Bounds x="400" y="420" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_t7" bpmnElement="t7">
        <dc:Bounds x="550" y="420" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ee3" bpmnElement="ee3">
        <dc:Bounds x="700" y="420" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p1" bpmnElement="p1">
        <dc:Bounds x="0" y="100" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p2" bpmnElement="p2">
        <dc:Bounds x="0" y="260" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p3" bpmnElement="p3">
        <dc:Bounds x="0" y="420" width="160" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_f1" bpmnElement="f1">
        <di:waypoint x="300" y="100"/>
        <di:waypoint x="250" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f2" bpmnElement="f2">
