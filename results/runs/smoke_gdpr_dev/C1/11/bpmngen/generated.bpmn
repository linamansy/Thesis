        <di:waypoint x="550" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f10" bpmnElement="f10">
        <di:waypoint x="200" y="420"/>
        <di:waypoint x="250" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f11" bpmnElement="f11">
