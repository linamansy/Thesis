<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="p1" name="Customer" processRef="CustomerProcess"/>
    <bpmn:participant id="p2" name="System" processRef="SystemProcess"/>
    <bpmn:participant id="p3" name="Inventory System" processRef="InventorySystemProcess"/>
    <bpmn:participant id="p4" name="Warehouse" processRef="WarehouseProcess"/>
    <bpmn:participant id="p5" name="Quality Control" processRef="QualityControlProcess"/>
    <bpmn:participant id="p6" name="Packaging" processRef="PackagingProcess"/>
    <bpmn:participant id="p7" name="Shipping Department" processRef="ShippingDepartmentProcess"/>
    <bpmn:participant id="p8" name="Returns Department" processRef="ReturnsDepartmentProcess"/>
    <bpmn:messageFlow id="mf1" name="Place Order" sourceRef="t1" targetRef="se2"/>
    <bpmn:messageFlow id="mf2" name="Payment Confirmation" sourceRef="t3" targetRef="ice1"/>
    <bpmn:messageFlow id="mf3" name="Payment Failed" sourceRef="ice1" targetRef="t4"/>
    <bpmn:messageFlow id="mf4" name="Stock Availability" sourceRef="t5" targetRef="se6"/>
    <bpmn:messageFlow id="mf5" name="Out of Stock" sourceRef="ice2" targetRef="t6"/>
    <bpmn:messageFlow id="mf6" name="Back-Order Received" sourceRef="ice3" targetRef="t7"/>
    <bpmn:messageFlow id="mf7" name="Items Available" sourceRef="ice4" targetRef="t8"/>
    <bpmn:messageFlow id="mf8" name="Picked Items" sourceRef="t9" targetRef="se10"/>
    <bpmn:messageFlow id="mf9" name="Quality Checked" sourceRef="ice5" targetRef="t11"/>
    <bpmn:messageFlow id="mf10" name="Packaging Complete" sourceRef="ice6" targetRef="se12"/>
    <bpmn:messageFlow id="mf11" name="Shipping Documents" sourceRef="t13" targetRef="se14"/>
    <bpmn:messageFlow id="mf12" name="Customs Documentation" sourceRef="t14" targetRef="se15"/>
    <bpmn:messageFlow id="mf13" name="Order Dispatched" sourceRef="ice7" targetRef="t16"/>
    <bpmn:messageFlow id="mf14" name="Shipping Confirmation" sourceRef="t17" targetRef="se18"/>
    <bpmn:messageFlow id="mf15" name="Inventory Updated" sourceRef="ice8" targetRef="t19"/>
    <bpmn:messageFlow id="mf16" name="Feedback Sent" sourceRef="ice9" targetRef="se20"/>
    <bpmn:messageFlow id="mf17" name="Issue Reported" sourceRef="ice10" targetRef="t21"/>
    <bpmn:messageFlow id="mf18" name="Return Label" sourceRef="t22" targetRef="se23"/>
    <bpmn:messageFlow id="mf19" name="Items Received" sourceRef="ice11" targetRef="t24"/>
    <bpmn:messageFlow id="mf20" name="Inspection Complete" sourceRef="ice12" targetRef="t25"/>
    <bpmn:messageFlow id="mf21" name="Refund/Replacement" sourceRef="ice13" targetRef="se26"/>
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="se1" name="Start"/>
    <bpmn:task id="t1" name="Place Order"/>
    <bpmn:intermediateCatchEvent id="ice1" name="Payment Failed">
      <bpmn:messageEventDefinition id="med1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2" name="Back-Order Received">
      <bpmn:messageEventDefinition id="med2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3" name="Items Available">
      <bpmn:messageEventDefinition id="med3"/>
    </bpmn:intermediateCatch, name="Order Dispatched">
      <bpmn:messageEventDefinition id="med4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice5" name="Quality Checked">
      <bpmn:messageEventDefinition id="med5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice6" name="Packaging Complete">
      <bpmn:messageEventDefinition id="med6"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice7" name="Order Dispatched">
      <bpmn:messageEventDefinition id="med7"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice8" name="Inventory Updated">
      <bpmn:messageEventDefinition id="med8"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice9" name="Feedback Sent">
      <bpmn:messageEventDefinition id="med9"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice10" name="Issue Reported">
      <bpmn:messageEventDefinition id="med10"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee1" name="End"/>
    <bpmn:sequenceFlow id="f1" sourceRef="se1" targetRef="t1"/>
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    <bpmn:sequenceFlow id="f31" sourceRef="ice9" targetRef="ee1"/>
    
    
    
    
    
    
    
    
    
    
    
  
    <bpmn:sequenceFlow id="auto_link_in_se1_to_ice2" sourceRef="se1" targetRef="ice2"/>
    <bpmn:sequenceFlow id="auto_link_out_ice2_to_ice3" sourceRef="ice2" targetRef="ice3"/>
    <bpmn:sequenceFlow id="auto_link_out_ice3_to_ice5" sourceRef="ice3" targetRef="ice5"/>
    <bpmn:sequenceFlow id="auto_link_out_ice5_to_ice6" sourceRef="ice5" targetRef="ice6"/>
    <bpmn:sequenceFlow id="auto_link_out_ice6_to_ice7" sourceRef="ice6" targetRef="ice7"/>
    <bpmn:sequenceFlow id="auto_link_out_ice7_to_ice8" sourceRef="ice7" targetRef="ice8"/>
    <bpmn:sequenceFlow id="auto_link_out_ice8_to_ice9" sourceRef="ice8" targetRef="ice9"/>
    <bpmn:sequenceFlow id="auto_link_in_ice9_to_ice10" sourceRef="ice9" targetRef="ice10"/>
    <bpmn:sequenceFlow id="auto_link_out_ice10_to_ee1" sourceRef="ice10" targetRef="ee1"/>
  </bpmn:process>
  <bpmn:process id="SystemProcess" isExecutable="false">
    <bpmn:startEvent id="se2" name="Order Received">
      <bpmn:messageEventDefinition id="med2_dup2"/>
    </bpmn:startEvent>
    <bpmn:task id="t3" name="Process Payment"/>
    <bpmn:intermediateCatchEvent id="ice1_dup2" name="Payment Failed">
      <bpmn:messageEventDefinition id="med1_dup2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice2_dup2" name="Back-Order Received">
      <bpmn:messageEventDefinition id="med2_dup3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3_dup2" name="Items Available">
      <bpmn:messageEventDefinition id="med3_dup2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice4" name="Inventory Updated">
      <bpmn:messageEvent, name="Inventory Updated">
      <bpmn:messageEventDefinition id="med8_dup2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee2" name="End"/>
    <bpmn:sequenceFlow id="f3" sourceRef="se2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="ice1"/>
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
  
    <bpmn:sequenceFlow id="auto_link_in_t3_to_ice2" sourceRef="t3" targetRef="ice2"/>
    <bpmn:sequenceFlow id="auto_link_out_ice2_to_ice3_dup2" sourceRef="ice2" targetRef="ice3"/>
    <bpmn:sequenceFlow id="auto_link_out_ice3_to_ice4" sourceRef="ice3" targetRef="ice4"/>
    <bpmn:sequenceFlow id="auto_link_out_ice4_to_ee2" sourceRef="ice4" targetRef="ee2"/>
  </bpmn:process>
  <bpmn:process id="InventorySystemProcess" isExecutable="false">
    <bpmn:startEvent id="se5" name="Stock Check">
      <bpmn:messageEventDefinition id="med5_dup2"/>
    </bpmn:startEvent>
    <bpmn:task id="t6" name="Check Stock Availability"/>
    <bpmn:intermediateCatchEvent id="ice2_dup3" name="Back-Order Received">
      <bpmn:messageEventDefinition id="med2_dup4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice3_dup3" name="Items Available">
      <bpmn:messageEventDefinition id="med3_dup3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee3" name="End"/>
    <bpmn:sequenceFlow id="f6" sourceRef="se5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t6" targetRef="ice2"/>
    
    
    <bpmn:sequenceFlow id="f10" sourceRef="ice3" targetRef="ee3"/>
  
    <bpmn:sequenceFlow id="auto_link_in_t6_to_ice3" sourceRef="t6" targetRef="ice3"/>
  </bpmn:process>
  <bpmn:process id="WarehouseProcess" isExecutable="false">
    <bpmn:startEvent id="se8" name="Pick Items">
      <bpmn:messageEventDefinition id="med8_dup3"/>
    </bpmn:startEvent>
    <bpmn:task id="t9" name="Pick Items from Warehouse"/>
    <bpmn:intermediateCatchEvent id="ice5_dup2" name="Quality Checked">
      <bpmn:messageEventDefinition id="med5_dup3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee4" name="End"/>
    <bpmn:sequenceFlow id="f12" sourceRef="se8" targetRef="t9"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t9" targetRef="ice5"/>
    <bpmn:sequenceFlow id="f14" sourceRef="ice5" targetRef="ee4"/>
  </bpmn:process>
  <bpmn:process id="QualityControlProcess" isExecutable="false">
    <bpmn:startEvent id="se10" name="Quality Check">
      <bpmn:messageEventDefinition id="med10_dup2"/>
    </bpmn:startEvent>
    <bpmn:task id="t11" name="Perform Quality Control"/>
    <bpmn:intermediateCatchEvent id="ice5_dup3" name="Quality Checked">
      <bpmn:messageEventDefinition id="med5_dup4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee5" name="End"/>
    <bpmn:sequenceFlow id="f14_dup2" sourceRef="se10" targetRef="t11"/>
    <bpmn:sequenceFlow id="f15" sourceRef="t11" targetRef="ice5"/>
    <bpmn:sequenceFlow id="f16" sourceRef="ice5" targetRef="ee5"/>
  </bpmn:process>
  <bpmn:process id="PackagingProcess" isExecutable="false">
    <bpmn:startEvent id="se13" name="Packaging Start">
      <bpmn:messageEventDefinition id="med13"/>
    </bpmn:startEvent>
    <bpmn:task id="t14" name="Pack Items"/>
    <bpmn:intermediateCatchEvent id="ice6_dup2" name="Packaging Complete">
      <bpmn:messageEventDefinition id="med6_dup2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee6" name="End"/>
    <bpmn:sequenceFlow id="f21" sourceRef="se13" targetRef="t14"/>
    <bpmn:sequenceFlow id="f22" sourceRef="t14" targetRef="ice6"/>
    <bpmn:sequenceFlow id="f23" sourceRef="ice6" targetRef="ee6"/>
  </bpmn:process>
  <bpmn:process id="ShippingDepartmentProcess" isExecutable="false">
    <bpmn:startEvent id="se15" name="Prepare Shipping Documents">
      <bpmn:messageEventDefinition id="med15"/>
    </bpmn:startEvent>
    <bpmn:task id="t16" name="Prepare Shipping Documents and Labels"/>
    <bpmn:intermediateCatchEvent id="ice7_dup2" name="Order Dispatched">
      <bpmn:messageEventDefinition id="med7_dup2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee7" name="End"/>
    <bpmn:sequenceFlow id="f23_dup2" sourceRef="se15" targetRef="t16"/>
    <bpmn:sequenceFlow id="f24" sourceRef="t16" targetRef="ice7"/>
    <bpmn:sequenceFlow id="f25" sourceRef="ice7" targetRef="ee7"/>
  </bpmn:process>
  <bpmn:process id="ReturnsDepartmentProcess" isExecutable="false">
    <bpmn:startEvent id="se22" name="Return Processing">
      <bpmn:messageEventDefinition id="med22"/>
    </bpmn:startEvent>
    <bpmn:task id="t21" name="Send Return Label"/>
    <bpmn:intermediateCatchEvent id="ice10_dup2" name="Issue Reported">
      <bpmn:messageEventDefinition id="med10_dup3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice11" name="Items Received">
      <bpmn:messageEventDefinition id="med11"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice12" name="Inspection Complete">
      <bpmn:messageEventDefinition id="med12"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ice13" name="Refund/Replacement">
      <bpmn:messageEventDefinition id="med13_dup2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee8" name="End"/>
    <bpmn:sequenceFlow id="f32" sourceRef="se22" targetRef="t21"/>
    
    
    
    
    
    
    
    
    
    <bpmn:sequenceFlow id="f42" sourceRef="ice13" targetRef="ee8"/>
  
    <bpmn:sequenceFlow id="auto_link_out_t21_to_ice11" sourceRef="t21" targetRef="ice11"/>
    <bpmn:sequenceFlow id="auto_link_out_ice11_to_ice12" sourceRef="ice11" targetRef="ice12"/>
    <bpmn:sequenceFlow id="auto_link_out_ice12_to_ice13" sourceRef="ice12" targetRef="ice13"/>
  </bpmn:process>
</bpmn:definitions>